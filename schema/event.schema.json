{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AK Concert Event Schema",
  "type": "object",
  "required": ["id", "date", "city", "venue", "category", "title"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the event"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Event date in YYYY-MM-DD format"
    },
    "city": {
      "type": "string",
      "description": "Alaskan city where event takes place"
    },
    "venue": {
      "type": "string",
      "description": "Venue name"
    },
    "category": {
      "type": "string",
      "enum": ["music", "comedy", "dance", "theatre", "community", "festival"],
      "description": "Event category"
    },
    "title": {
      "type": "string",
      "description": "Event title or performing artist/band name"
    },
    "time": {
      "type": "string",
      "description": "Event start/end time"
    },
    "ticketUrl": {
      "type": "string",
      "description": "URL to ticket purchase or details page"
    },
    "cost": {
      "type": "string",
      "description": "Ticket price or admission cost"
    }
  }
}
