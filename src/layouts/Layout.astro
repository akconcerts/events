---
import A11yPanel from '../components/A11yPanel.astro';
import VenueModal from '../components/VenueModal.astro';
import MobileNavFloor from '../components/MobileNavFloor.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "AK Concerts — Alaska's Premier Live Music & Events Calendar",
  description = "Discover live concerts, music festivals, comedy shows, and events across Anchorage, Fairbanks, Juneau, Homer, and all of Alaska.",
  image = "https://akconcerts.com/images/og-default.jpg",
} = Astro.props;

const siteUrl = "https://akconcerts.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const orgJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "AK Concerts",
      "legalName": "AK Concerts LLC",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/logo.png`,
        "caption": "AK Concerts Logo"
      },
      "description": "The statewide source of truth for live music, comedy, festivals, and events across Alaska.",
      "email": "hello@akconcerts.com",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Alaska",
        "sameAs": "https://en.wikipedia.org/wiki/Alaska"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Anchorage",
        "addressRegion": "AK",
        "addressCountry": "US"
      },
      "sameAs": [
        "https://www.facebook.com/akconcerts",
        "https://www.instagram.com/akconcert/",
        "https://www.snapchat.com/add/akconcerts"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "AK Concerts",
      "description": "Alaska's Premier Live Music & Events Directory",
      "publisher": {
        "@id": `${siteUrl}/#organization`
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/?search={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is AK Concerts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AK Concerts is Alaska's official statewide live entertainment directory, providing daily curated concert schedules, festival listings, comedy shows, and venue guides across Anchorage, Fairbanks, Juneau, Kenai Peninsula, Wasilla, Seward, and beyond."
          }
        },
        {
          "@type": "Question",
          "name": "Where can I find live music in Alaska tonight?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can find tonight's live music and concert listings on AK Concerts (akconcerts.com), updated daily with real-time show times, venue locations, band details, and direct ticket links."
          }
        },
        {
          "@type": "Question",
          "name": "How do I submit an event to AK Concerts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bands, venues, and event organizers can submit upcoming Alaska live events directly at akconcerts.com/submit."
          }
        }
      ]
    }
  ]
};
---
<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots & Generative Engine Indexing -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Geo Targeting Meta Tags (Alaska) -->
    <meta name="geo.region" content="US-AK" />
    <meta name="geo.placename" content="Anchorage, Alaska" />
    <meta name="geo.position" content="61.2181;-149.9003" />
    <meta name="ICBM" content="61.2181, -149.9003" />

    <!-- OpenGraph SEO -->
    <meta property="og:site_name" content="AK Concerts" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card SEO -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>
  <body>
    <A11yPanel />
    <VenueModal />
    <slot />
    <MobileNavFloor />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
