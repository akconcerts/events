---
import A11yPanel from '../components/A11yPanel.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AK Concerts — Alaska's Live Music & Events",
  description = "Alaska's statewide live music, comedy and festival calendar. Anchorage, Fairbanks, Juneau and beyond — curated daily.",
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="AK Concerts" />
    <meta property="og:description" content="Alaska's live entertainment network." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <A11yPanel />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
