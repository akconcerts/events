---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EventJsonLd from '../../components/EventJsonLd.astro';
import { events } from '../../data/events';
import { Music, Smile, PartyPopper, Theater, Users, Tent, Sparkles, Flame, Calendar, Ticket, Snowflake } from 'lucide-astro';

export function getStaticPaths() {
  const isWeekend = (e: any) => ['2026-05-09', '2026-05-10', '2026-05-11'].includes(e.date);
  return [
    { params: { filter: 'tonight' }, props: { name: 'Tonight', description: 'Events happening tonight across Alaska.', filterFn: (e: any) => e.date === '2026-05-09' } },
    { params: { filter: 'this-weekend' }, props: { name: 'This Weekend', description: 'Events happening this weekend.', filterFn: isWeekend } },
    { params: { filter: 'live-music' }, props: { name: 'Live Music', description: 'Live music performances across Alaska.', filterFn: (e: any) => e.category === 'music' } },
    { params: { filter: 'comedy' }, props: { name: 'Comedy', description: 'Stand-up comedy and improv shows.', filterFn: (e: any) => e.category === 'comedy' } },
    { params: { filter: 'festivals' }, props: { name: 'Festivals', description: 'Festivals and large outdoor events.', filterFn: (e: any) => e.category === 'festival' } },
    { params: { filter: 'free-events' }, props: { name: 'Free Events', description: 'Free entry events and community gatherings.', filterFn: (e: any) => e.category === 'community' } },
    { params: { filter: 'touring-ak' }, props: { name: 'Touring AK', description: 'Major touring acts performing in Alaska.', filterFn: (e: any) => e.category === 'music' || e.category === 'comedy' } },
    { params: { filter: 'winter-series' }, props: { name: 'Winter Series', description: 'Winter event series and indoor specials.', filterFn: (e: any) => false } },
  ];
}

const { name, description, filterFn } = Astro.props;

// For Touring AK and Winter Series, since we don't have perfect flags, we just apply generic rules.
let filteredEvents = events.filter(filterFn).sort((a, b) => b.date.localeCompare(a.date));

// Fallbacks if lists are empty (e.g. Winter Series)
if (name === 'Touring AK' && filteredEvents.length > 5) {
  filteredEvents = filteredEvents.slice(0, 5); // Just an example subset
}
if (name === 'Winter Series' && filteredEvents.length === 0) {
  // Just show some upcoming events to not look broken
  filteredEvents = events.slice(0, 6);
}
if (name === 'Free Events' && filteredEvents.length === 0) {
  filteredEvents = events.filter(e => e.category === 'community');
}

const categoryIcons: Record<string, any> = {
  music: Music,
  comedy: Smile,
  dance: PartyPopper,
  theatre: Theater,
  community: Users,
  festival: Tent,
};
---

<Layout title={`${name} — AK Concerts`} description={description}>
  <EventJsonLd events={filteredEvents} />
  <SiteHeader />
  <main class="filter-page container">
    <div class="filter-header">
      <p class="filter-eyebrow">Quick Filter</p>
      <h1 class="filter-title font-display">{name}</h1>
      <p class="filter-sub">{filteredEvents.length} event{filteredEvents.length !== 1 ? 's' : ''} matching this category.</p>
    </div>

    <div class="event-list">
      {filteredEvents.length > 0 ? filteredEvents.map(e => {
        const Icon = categoryIcons[e.category] || Music;
        return (
          <a href={`/events/${e.slug}`} class="event-row">
            <span class="event-row-icon"><Icon size={14} /></span>
            <span class="event-row-date">{e.date}</span>
            <span class="event-row-venue" data-city={e.city}>{e.venue}</span>
            <span class="event-row-sep">—</span>
            <span class="event-row-title">{e.title}</span>
            <span class="event-row-city">{e.city}</span>
            <span class="event-row-time">{e.time}</span>
          </a>
        );
      }) : (
        <p class="no-events">No events found for this filter.</p>
      )}
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
.filter-page { padding-block: 3.5rem 4rem; }
.filter-header { margin-bottom: 2.5rem; }
.filter-eyebrow { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; color: var(--brand-gold); margin-bottom: .5rem; }
.filter-title { font-size: 2.5rem; font-weight: 700; letter-spacing: -.03em; }
@media (min-width: 640px) { .filter-title { font-size: 3.5rem; } }
.filter-sub { margin-top: .5rem; color: var(--muted-foreground); }

.event-list { display: flex; flex-direction: column; gap: .25rem; }
.event-row { display: flex; align-items: center; gap: .5rem; padding: .625rem .75rem; border-radius: .5rem; font-size: .875rem; transition: background .15s; flex-wrap: wrap; }
.event-row:hover { background: var(--card); }
.event-row-icon { font-size: .875rem; flex-shrink: 0; }
.event-row-date { font-size: .75rem; font-weight: 600; color: var(--brand-gold); min-width: 5.5rem; flex-shrink: 0; }
.event-row-venue { color: var(--muted-foreground); flex-shrink: 0; }
.event-row-sep { color: var(--muted-foreground); opacity: .4; flex-shrink: 0; }
.event-row-title { font-weight: 600; flex: 1; min-width: 0; }
.event-row-city { font-size: .75rem; font-weight: 500; color: var(--brand-gold-light); margin-left: auto; margin-right: 1rem; }
.event-row-time { font-size: .75rem; color: var(--muted-foreground); flex-shrink: 0; }
@media (max-width: 639px) {
  .event-row { font-size: .8125rem; gap: .375rem; }
  .event-row-venue, .event-row-sep, .event-row-city { display: none; }
}
.no-events { color: var(--muted-foreground); font-style: italic; }
</style>
