---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import QuickNav from '../components/QuickNav.astro';
import CityStrip from '../components/CityStrip.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventFilterBar from '../components/EventFilterBar.astro';
import EventJsonLd from '../components/EventJsonLd.astro';
import Newsletter from '../components/Newsletter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ConcertMap from '../components/ConcertMap.astro';
import { events, cities } from '../data/events';
import { getAlaskaTodayDate, getAlaskaDaysAgoDate, isEventPast, formatFullTime } from '../utils/date';

import { Music, Smile, PartyPopper, Theater, Users, Tent } from 'lucide-astro';

const sevenDaysAgo = getAlaskaDaysAgoDate(7);
const currentDate = getAlaskaTodayDate();
const upcomingEvents = events.filter(e => e.date >= sevenDaysAgo);

const sortedEvents = [...upcomingEvents].sort((a, b) => {
  const d = a.date.localeCompare(b.date);
  if (d !== 0) return d;
  return a.time.localeCompare(b.time);
});

// Group by City
const eventsByCity: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByCity[e.city]) eventsByCity[e.city] = [];
  eventsByCity[e.city].push(e);
}
const sortedCities = Object.keys(eventsByCity).sort();

// Group by Venue
const eventsByVenue: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByVenue[e.venue]) eventsByVenue[e.venue] = [];
  eventsByVenue[e.venue].push(e);
}
const sortedVenues = Object.keys(eventsByVenue).sort();

// Group by Category
const eventsByCategory: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByCategory[e.category]) eventsByCategory[e.category] = [];
  eventsByCategory[e.category].push(e);
}
const sortedCategories = Object.keys(eventsByCategory).sort();

const fmtDate = (iso: string) => {
  const d = new Date(iso + 'T12:00:00');
  return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' });
};

const categoryIcons: Record<string, any> = {
  music: Music,
  comedy: Smile,
  dance: PartyPopper,
  theatre: Theater,
  community: Users,
  festival: Tent,
};

const formatCategoryName = (cat: string) => {
  const names: Record<string, string> = {
    music: "Live Music",
    comedy: "Comedy",
    dance: "Dance",
    theatre: "Theatre & Arts",
    community: "Community",
    festival: "Festivals"
  };
  return names[cat] || cat;
}
---

<Layout title="AK Concerts — Alaska's Live Music & Events Tonight" description="Discover Alaska concerts, festivals, comedy and live music tonight. Anchorage, Fairbanks, Juneau and beyond — curated daily.">
  <EventJsonLd events={sortedEvents} />
  <SiteHeader />
  <main>
    <Hero />
    <QuickNav />
    <CityStrip />
    <ConcertMap />

    <section id="playing-soon" class="events-section container">
      <SectionHeading eyebrow="What's Happening in Alaska" title="Playing Soon" />
      <EventFilterBar events={sortedEvents} showTimelineFilter={false} />

      <!-- View: Date (Flat List) -->
      <div id="view-date" class="events-view-container" style="display: block;">
        <div class="group-block">
          <div class="event-list">
            {sortedEvents.map(e => {
              const Icon = categoryIcons[e.category] || Music;
              return (
                <a 
                  href={`/events/${e.slug}`} 
                  class="event-row"
                  data-city={e.city}
                  data-date={e.date}
                  data-venue={e.venue}
                  data-category={e.category}
                >
                  <span class="event-row-icon"><Icon size={14} /></span>
                  <span class="event-row-date">{e.date}</span>
                  {isEventPast(e.date, e.time) && <span class="event-row-past-pill">PAST EVENT</span>}
                  <span class="event-row-city-pill">{e.city}</span>
                  <span class="event-row-venue" data-city={e.city}>{e.venue}</span>
                  <span class="event-row-sep">—</span>
                  <span class="event-row-title">{e.title}</span>
                  <span class="event-row-time">{e.time}</span>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      <!-- View: City -->
      <div id="view-city" class="events-view-container" style="display: none;">
        {sortedCities.map(city => (
          <div class="city-block group-block">
            <h3 class="city-name font-display">{city}</h3>
            <div class="event-list">
              {eventsByCity[city].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    <span class="event-row-venue" data-city={e.city}>{e.venue}</span>
                    <span class="event-row-sep">—</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- View: Venue -->
      <div id="view-venue" class="events-view-container" style="display: none;">
        {sortedVenues.map(venue => (
          <div class="venue-block group-block">
            <h3 class="city-name font-display event-row-venue" data-city={eventsByVenue[venue][0].city} style="display:inline-block;">{venue}</h3> <span style="font-size: 1rem; color: var(--muted-foreground); margin-left: .5rem; font-family: var(--font-sans); font-weight: 500;">{eventsByVenue[venue][0].city}</span>
            <div class="event-list">
              {eventsByVenue[venue].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    <span class="event-row-sep">—</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- View: Category -->
      <div id="view-category" class="events-view-container" style="display: none;">
        {sortedCategories.map(cat => (
          <div class="category-block group-block">
            <h3 class="city-name font-display">{formatCategoryName(cat)}</h3>
            <div class="event-list">
              {eventsByCategory[cat].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    {isEventPast(e.date, e.time) && <span class="event-row-past-pill">PAST EVENT</span>}
                    <span class="event-row-city-pill">{e.city}</span>
                    <span class="event-row-venue" data-city={e.city}>{e.venue}</span>
                    <span class="event-row-sep">—</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

    </section>

    <Newsletter />
  </main>
  <SiteFooter />
</Layout>

<style>
.events-section{padding-block:3.5rem 2rem}
.city-block{margin-bottom:2.5rem}
.city-name{font-size:1.25rem;font-weight:700;color:var(--brand-gold);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.event-list{display:flex;flex-direction:column;gap:.25rem}
.event-row{display:flex;align-items:center;gap:.5rem;padding:.625rem .75rem;border-radius:.5rem;font-size:.875rem;transition:background .15s;flex-wrap:wrap}
.event-row:hover{background:var(--card)}
.event-row-icon{font-size:.875rem;flex-shrink:0}
.event-row-date{font-size:.75rem;font-weight:600;color:var(--brand-gold);min-width:5.5rem;flex-shrink:0}
.event-row-past-pill{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;background:rgba(239,68,68,0.18);border:1px solid rgba(239,68,68,0.5);color:#ef4444;padding:.125rem .375rem;border-radius:.25rem;flex-shrink:0}
.event-row-city-pill{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;background:var(--secondary);border:1px solid var(--border);padding:.125rem .375rem;border-radius:.25rem;color:var(--muted-foreground);flex-shrink:0}
.event-row-venue{color:var(--muted-foreground);flex-shrink:0}
.event-row-sep{color:var(--muted-foreground);opacity:.4;flex-shrink:0}
.event-row-title{font-weight:600;flex:1;min-width:0}
.event-row-time{font-size:.95rem;font-weight:700;color:var(--brand-gold);flex-shrink:0;margin-left:auto}
@media(max-width:767px){
  .event-row{display:flex;flex-direction:column;align-items:flex-start;gap:.35rem;padding:.85rem 1rem;border-radius:.75rem;background:rgba(255,255,255,0.02);border:1px solid var(--border);margin-bottom:.35rem}
  .event-row-icon,.event-row-date,.event-row-past-pill,.event-row-city-pill{order:1}
  .event-row-venue{display:inline-block !important;order:2;font-size:.85rem;color:var(--muted-foreground);font-weight:500}
  .event-row-time{display:inline-block !important;order:2;margin-left:auto;font-size:.9rem;font-weight:700;color:var(--brand-gold)}
  .event-row-sep{display:none}
  .event-row-title{width:100%;order:3;font-weight:800;font-size:1.05rem;margin-top:.15rem;color:#ffffff;line-height:1.35}
}
</style>

<script is:inline>
  (function() {
    function updateAlaskaTimeAwareness() {
      try {
        // Exact Alaska Date (YYYY-MM-DD)
        var alaskaDateFormatter = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'America/Anchorage',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        });
        var alaskaToday = alaskaDateFormatter.format(new Date());

        // Exact Alaska Time (24h format)
        var alaskaTimeFormatter = new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/Anchorage',
          hour: 'numeric',
          minute: 'numeric',
          hour12: false
        });
        var curTimeStr = alaskaTimeFormatter.format(new Date());
        var curParts = curTimeStr.split(':');
        var curMinutes = parseInt(curParts[0], 10) * 60 + parseInt(curParts[1], 10);

        document.querySelectorAll('.event-row').forEach(function(row) {
          var date = row.getAttribute('data-date');
          var pastPill = row.querySelector('.event-row-past-pill');
          if (!date) return;

          var isPast = false;
          if (date < alaskaToday) {
            isPast = true;
          } else if (date === alaskaToday) {
            var timeElem = row.querySelector('.event-row-time');
            var rawTime = timeElem ? timeElem.textContent.trim() : '';
            if (rawTime) {
              var match = rawTime.match(/(?:-\s*)?(\d{1,2})(?::(\d{2}))?\s*(a|p|am|pm)?\s*$/i);
              if (match) {
                var hour = parseInt(match[1], 10);
                var min = match[2] ? parseInt(match[2], 10) : 0;
                var ampm = (match[3] || '').toLowerCase();
                if (ampm.indexOf('p') === 0 && hour < 12) hour += 12;
                if (ampm.indexOf('a') === 0 && hour === 12) hour = 0;
                var endMinutes = hour * 60 + min;
                if (hour < 5 && rawTime.toLowerCase().indexOf('p') !== -1) {
                  endMinutes += 24 * 60;
                }
                if (curMinutes > endMinutes) {
                  isPast = true;
                }
              }
            }
          }

          if (isPast) {
            if (!pastPill) {
              var cityPill = row.querySelector('.event-row-city-pill');
              if (cityPill) {
                var newPill = document.createElement('span');
                newPill.className = 'event-row-past-pill';
                newPill.textContent = 'PAST EVENT';
                cityPill.parentNode.insertBefore(newPill, cityPill);
              }
            }
          } else {
            if (pastPill) {
              pastPill.remove();
            }
          }
        });
      } catch(e) {}
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateAlaskaTimeAwareness);
    } else {
      updateAlaskaTimeAwareness();
    }
  })();
</script>
