---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout title="Support AK Concerts — Alaska's Live Music Guide" description="Support AK Concerts — Alaska's free, volunteer-run live entertainment listing. Help keep Alaska's music scene visible.">
  <SiteHeader />
  <main class="support-page container">
    <div class="support-hero">
      <img src="/images/logo.png" alt="AK Concerts" width="80" height="80" class="support-logo" />
      <h1 class="support-title font-display">Support <span class="text-gold">AK Concerts</span></h1>
      <p class="support-sub">AK Concerts is a free, volunteer-run resource that curates Alaska's live music, comedy, and festival scene. Your support keeps it going.</p>
    </div>

    <div class="support-grid">
      <div class="support-card">
        <div class="support-icon">📣</div>
        <h3 class="support-card-title font-display">Spread the Word</h3>
        <p class="support-card-text">Share AK Concerts with friends, venues, and artists. The more people who know about us, the stronger Alaska's music community becomes.</p>
      </div>
      <div class="support-card">
        <div class="support-icon">📩</div>
        <h3 class="support-card-title font-display">Submit Events</h3>
        <p class="support-card-text">Know about a show we missed? Email us your event details and we'll add it to the schedule.</p>
      </div>
      <div class="support-card">
        <div class="support-icon">💛</div>
        <h3 class="support-card-title font-display">Donate</h3>
        <p class="support-card-text">Even small contributions help cover hosting and keep AK Concerts ad-free. Every dollar supports Alaska's music scene.</p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
.support-page{padding-top:3rem;padding-bottom:4rem;min-height:70vh}
.support-hero{text-align:center;margin-bottom:3rem}
.support-logo{border-radius:50%;margin:0 auto 1.5rem}
.support-title{font-size:2.5rem;font-weight:700;letter-spacing:-.03em;margin-bottom:.75rem}
@media(min-width:640px){.support-title{font-size:3.5rem}}
.support-sub{max-width:36rem;margin:0 auto;color:var(--muted-foreground);line-height:1.7}
.support-grid{display:grid;gap:1.25rem}
@media(min-width:768px){.support-grid{grid-template-columns:repeat(3,1fr)}}
.support-card{border-radius:1rem;border:1px solid var(--border);background:var(--card);padding:1.75rem;transition:border-color .2s}
.support-card:hover{border-color:color-mix(in oklab,var(--brand-gold) 50%,transparent)}
.support-icon{font-size:1.75rem;margin-bottom:.75rem}
.support-card-title{font-size:1.125rem;font-weight:700;margin-bottom:.5rem}
.support-card-text{font-size:.875rem;color:var(--muted-foreground);line-height:1.6}
</style>
