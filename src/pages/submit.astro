---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const cities = [
  "Anchorage", "Barrow", "Bethel", "Big Lake", "Chugiak", "Cooper Landing", "Cordova", 
  "Eagle River", "Ester", "Fairbanks", "Girdwood", "Haines", "Homer", "Hope", "Juneau", 
  "Kenai", "Ketchikan", "Kodiak", "McCarthy", "North Pole", "Palmer", "Seldovia", "Seward", 
  "Skagway", "Soldotna", "Sterling", "Talkeetna", "Valdez", "Wasilla"
].sort();

const categories = ["music", "comedy", "dance", "theatre", "community", "festival"];
---

<Layout title="Submit Event & Claim Venue — AK Concerts" description="Submit your live entertainment event or claim your Alaska music venue. Approval workflow powers akconcerts.com instantly.">
  <SiteHeader />
  <main class="submit-page container">
    <div class="submit-header">
      <p class="submit-eyebrow">Promote Your Show & Venue</p>
      <h1 class="submit-title font-display">Event Submission & Venue Claim</h1>
      <p class="submit-sub">Submissions are logged into Cody's approval sheet. Once approved, your show or venue goes live automatically across Alaska!</p>

      <!-- Form Mode Tabs -->
      <div class="form-tabs">
        <button id="tab-event" class="tab-btn active" data-tab="event">🎸 Submit an Event / Show</button>
        <button id="tab-venue" class="tab-btn" data-tab="venue">🏛️ Claim or Register a Venue</button>
      </div>
    </div>

    <div class="form-container">
      <div id="submit-success-alert" class="alert alert-success" style="display: none;">
        <span class="alert-icon">✓</span>
        <div class="alert-content">
          <h4>Submission Received!</h4>
          <p>Your submission has been logged into the pending review queue. Once Cody clicks <strong>Approve</strong>, your event will go live!</p>
        </div>
      </div>

      <div id="submit-error-alert" class="alert alert-error" style="display: none;">
        <span class="alert-icon">✗</span>
        <div class="alert-content">
          <h4>Submission Error</h4>
          <p id="submit-error-message">Something went wrong. Please verify form values and try again.</p>
        </div>
      </div>

      <!-- FORM 1: EVENT SUBMISSION -->
      <form id="event-submission-form" class="submit-form">
        <input type="hidden" name="formType" value="event" />

        <div class="form-grid">
          <div class="form-group full-width">
            <label for="event-title">Event Title / Artist Name <span class="required">*</span></label>
            <input type="text" id="event-title" name="title" required placeholder="e.g. Blackwater Railroad Company Live" />
          </div>

          <div class="form-group">
            <label for="event-date">Event Date <span class="required">*</span></label>
            <input type="date" id="event-date" name="date" required />
          </div>

          <div class="form-group">
            <label for="event-time">Show / Door Time <span class="required">*</span></label>
            <input type="text" id="event-time" name="time" required placeholder="e.g. 9p-1a or 8:30p" />
          </div>

          <div class="form-group">
            <label for="event-city">City <span class="required">*</span></label>
            <select id="event-city" name="city" required>
              <option value="">Select an Alaskan City</option>
              {cities.map(city => <option value={city}>{city}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="event-venue">Venue Name <span class="required">*</span></label>
            <input type="text" id="event-venue" name="venue" required placeholder="e.g. Koot's, Bear Tooth, Sitzmark" />
          </div>

          <div class="form-group">
            <label for="event-category">Category <span class="required">*</span></label>
            <select id="event-category" name="category" required>
              <option value="">Select a Category</option>
              {categories.map(cat => <option value={cat}>{cat.charAt(0).toUpperCase() + cat.slice(1)}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="event-cost">Admission / Ticket Cost</label>
            <input type="text" id="event-cost" name="cost" placeholder="e.g. $15, Free, $20-$30" />
          </div>

          <div class="form-group full-width">
            <label for="event-ticketurl">Ticket URL / Info Link</label>
            <input type="url" id="event-ticketurl" name="ticketUrl" placeholder="https://example.com/tickets" />
          </div>

          <div class="form-group full-width">
            <label for="event-email">Submitter Email <span class="required">*</span></label>
            <input type="email" id="event-email" name="email" required placeholder="your.email@example.com (For confirmation & approval queries)" />
          </div>
        </div>

        <button type="submit" id="submit-event-btn" class="form-submit-btn bg-gradient-gold">
          Submit Event for Approval
        </button>
      </form>

      <!-- FORM 2: VENUE CLAIM / REGISTRATION -->
      <form id="venue-claim-form" class="submit-form" style="display: none;">
        <input type="hidden" name="formType" value="venue_claim" />

        <div class="form-grid">
          <div class="form-group full-width">
            <label for="venue-name">Venue Name <span class="required">*</span></label>
            <input type="text" id="venue-name" name="venueName" required placeholder="e.g. Chilkoot Charlie's" />
          </div>

          <div class="form-group">
            <label for="venue-city">City <span class="required">*</span></label>
            <select id="venue-city" name="city" required>
              <option value="">Select an Alaskan City</option>
              {cities.map(city => <option value={city}>{city}</option>)}
            </select>
          </div>

          <div class="form-group">
            <label for="venue-capacity">Guest Capacity</label>
            <input type="number" id="venue-capacity" name="capacity" placeholder="e.g. 500" />
          </div>

          <div class="form-group full-width">
            <label for="venue-address">Street Address</label>
            <input type="text" id="venue-address" name="address" placeholder="e.g. 2435 Spenard Rd, Anchorage, AK 99503" />
          </div>

          <div class="form-group">
            <label for="contact-name">Manager / Owner Name <span class="required">*</span></label>
            <input type="text" id="contact-name" name="contactName" required placeholder="Your Full Name" />
          </div>

          <div class="form-group">
            <label for="contact-email">Contact Email <span class="required">*</span></label>
            <input type="email" id="contact-email" name="contactEmail" required placeholder="manager@venue.com" />
          </div>

          <div class="form-group full-width">
            <label for="venue-notes">Regular Weekly Events / Notes</label>
            <textarea id="venue-notes" name="notes" rows="3" placeholder="e.g. Fireside Thursdays DJ 10p, Open Mic Night Tuesdays 8p"></textarea>
          </div>
        </div>

        <button type="submit" id="submit-venue-btn" class="form-submit-btn bg-gradient-gold">
          Submit Venue Claim & Registration
        </button>
      </form>
    </div>
  </main>
  <SiteFooter />
</Layout>

<script>
  const FORM_URL = import.meta.env.PUBLIC_SUBMIT_FORM_URL || '';

  const tabEvent = document.getElementById('tab-event');
  const tabVenue = document.getElementById('tab-venue');
  const formEvent = document.getElementById('event-submission-form') as HTMLFormElement;
  const formVenue = document.getElementById('venue-claim-form') as HTMLFormElement;
  const successAlert = document.getElementById('submit-success-alert') as HTMLDivElement;
  const errorAlert = document.getElementById('submit-error-alert') as HTMLDivElement;
  const errorMessage = document.getElementById('submit-error-message') as HTMLParagraphElement;

  // Tab Switcher Logic
  tabEvent?.addEventListener('click', () => {
    tabEvent.classList.add('active');
    tabVenue?.classList.remove('active');
    formEvent.style.display = 'flex';
    formVenue.style.display = 'none';
    successAlert.style.display = 'none';
    errorAlert.style.display = 'none';
  });

  tabVenue?.addEventListener('click', () => {
    tabVenue.classList.add('active');
    tabEvent?.classList.remove('active');
    formVenue.style.display = 'flex';
    formEvent.style.display = 'none';
    successAlert.style.display = 'none';
    errorAlert.style.display = 'none';
  });

  // Handle Submission for both forms
  async function handleSubmit(formEl: HTMLFormElement, btnId: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Submitting...';
    successAlert.style.display = 'none';
    errorAlert.style.display = 'none';

    const formData = new FormData(formEl);
    const data = Object.fromEntries(formData.entries());

    if (!FORM_URL) {
      // Simulation mode
      setTimeout(() => {
        btn.disabled = false;
        btn.textContent = formEl.id === 'event-submission-form' ? 'Submit Event for Approval' : 'Submit Venue Claim';
        successAlert.style.display = 'flex';
        formEl.reset();
      }, 1200);
      return;
    }

    try {
      const response = await fetch(FORM_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      btn.disabled = false;
      btn.textContent = formEl.id === 'event-submission-form' ? 'Submit Event for Approval' : 'Submit Venue Claim';

      if (result.status === 'success') {
        successAlert.style.display = 'flex';
        formEl.reset();
      } else {
        errorMessage.textContent = result.message || 'Submission error.';
        errorAlert.style.display = 'flex';
      }
    } catch (err: any) {
      btn.disabled = false;
      btn.textContent = formEl.id === 'event-submission-form' ? 'Submit Event for Approval' : 'Submit Venue Claim';
      errorMessage.textContent = err.message || 'Error connecting to Google Sheets Web App.';
      errorAlert.style.display = 'flex';
    }
  }

  formEvent?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleSubmit(formEvent, 'submit-event-btn');
  });

  formVenue?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleSubmit(formVenue, 'submit-venue-btn');
  });
</script>

<style>
.submit-page { padding-block: 3.5rem 4rem; }
.submit-header { margin-bottom: 2.5rem; text-align: center; }
.submit-eyebrow { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; color: var(--brand-gold); margin-bottom: .5rem; }
.submit-title { font-size: 2.5rem; font-weight: 700; letter-spacing: -.03em; }
@media (min-width: 640px) { .submit-title { font-size: 3.5rem; } }
.submit-sub { margin-top: .5rem; color: var(--muted-foreground); max-width: 34rem; margin-inline: auto; }

.form-tabs {
  display: inline-flex;
  gap: .5rem;
  background: var(--card);
  border: 1px solid var(--border);
  padding: .35rem;
  border-radius: 9999px;
  margin-top: 1.5rem;
}
.tab-btn {
  background: transparent;
  color: var(--muted-foreground);
  border: none;
  padding: .6rem 1.25rem;
  border-radius: 9999px;
  font-size: .875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all .2s;
}
.tab-btn:hover, .tab-btn.active {
  background: var(--brand-gold);
  color: var(--brand-navy);
}

.form-container {
  max-width: 42rem;
  margin-inline: auto;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 2.25rem;
  box-shadow: 0 10px 40px -15px rgba(0,0,0,0.3);
}

.submit-form { display: flex; flex-direction: column; gap: 1.5rem; }
.form-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
@media (min-width: 640px) { .form-grid { grid-template-columns: repeat(2, 1fr); } }
.form-group { display: flex; flex-direction: column; gap: .375rem; }
.form-group.full-width { grid-column: 1 / -1; }
.form-group label { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; color: var(--muted-foreground); }
.required { color: #ef4444; }
.form-group input, .form-group select, .form-group textarea {
  background: var(--background);
  border: 1px solid var(--border);
  color: var(--foreground);
  padding: .75rem;
  border-radius: .375rem;
  font-size: .875rem;
  outline: none;
  transition: border-color .15s;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--brand-gold); }

.form-submit-btn {
  margin-top: 1rem;
  border-radius: .375rem;
  padding: 1rem;
  font-weight: 700;
  color: var(--neon-foreground);
  text-align: center;
  transition: opacity .2s;
  box-shadow: 0 8px 30px -10px var(--brand-gold);
  cursor: pointer;
}
.form-submit-btn:hover:not(:disabled) { opacity: .95; }
.form-submit-btn:disabled { opacity: .5; cursor: not-allowed; }

.alert { display: flex; gap: 1rem; padding: 1rem; border-radius: .5rem; margin-bottom: 1.5rem; font-size: .875rem; line-height: 1.4; }
.alert-icon { font-size: 1.25rem; font-weight: 700; line-height: 1; }
.alert-content h4 { font-weight: 700; margin-bottom: .25rem; }
.alert-success { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); color: #22c55e; }
.alert-error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; }
</style>
