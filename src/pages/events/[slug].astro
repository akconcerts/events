---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { events } from '../../data/events';
import { formatFullTime } from '../../utils/date';

export function getStaticPaths() {
  // Generate static pages for all events from 2025 onwards (or active/upcoming events)
  const activeEvents = events.filter(e => e.date >= '2025-01-01');
  return activeEvents.map(event => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  "name": event.title,
  "startDate": event.date,
  "location": {
    "@type": "Place",
    "name": event.venue,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": event.city,
      "addressRegion": "AK",
      "addressCountry": "US"
    }
  },
  "performer": {
    "@type": "PerformingGroup",
    "name": event.title
  },
  "organizer": {
    "@type": "Organization",
    "name": "AK Concerts",
    "url": "https://akconcerts.com"
  },
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "url": `https://akconcerts.com/events/${event.slug}`
};

const categoryLabels: Record<string, string> = {
  music: 'Live Music',
  comedy: 'Comedy',
  dance: 'Dance',
  theatre: 'Theatre',
  community: 'Community',
  festival: 'Festival',
};
---

<Layout title={`${event.title} at ${event.venue} — AK Concerts`} description={`${event.title} at ${event.venue} in ${event.city}, Alaska. ${fmtDate(event.date)} ${formatFullTime(event.time)}`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <SiteHeader />
  <main class="event-page container">
    <div class="event-breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <a href="/">Events</a> <span class="sep">/</span> <span>{event.title}</span>
    </div>

    <div class="event-hero">
      <div class="event-hero-badge">{categoryLabels[event.category] || 'Event'}</div>
      <h1 class="event-hero-title font-display">{event.title}</h1>
      <p class="event-hero-venue">{event.venue}</p>
    </div>

    <div class="event-details">
      <div class="detail-card">
        <div class="detail-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
        </div>
        <div>
          <div class="detail-label">Date</div>
          <div class="detail-value">{fmtDate(event.date)}</div>
        </div>
      </div>

      <div class="detail-card">
        <div class="detail-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <div class="detail-label">Time</div>
          <div class="detail-value">{formatFullTime(event.time)}</div>
        </div>
      </div>

      <div class="detail-card">
        <div class="detail-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <div>
          <div class="detail-label">Location</div>
          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.venue + ', ' + event.city + ', AK')}`} target="_blank" rel="noopener noreferrer" class="detail-value map-link">
            {event.venue}, {event.city}
          </a>
        </div>
      </div>
    </div>

    <div class="event-actions">
      <a href={event.ticketUrl} target="_blank" rel="noopener noreferrer" class="action-btn bg-gradient-gold">
        More Info / Tickets
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
      </a>
      <a href="/" class="action-btn-secondary">
        ← Back to All Events
      </a>
    </div>
  </main>
  <SiteFooter />
</Layout>

<style>
.event-page{padding-top:2rem;padding-bottom:4rem;min-height:70vh}
.event-breadcrumb{display:flex;align-items:center;gap:.5rem;font-size:.75rem;color:var(--muted-foreground);margin-bottom:2rem}
.event-breadcrumb a:hover{color:var(--foreground)}
.sep{opacity:.4}
.event-hero{margin-bottom:2.5rem}
.event-hero-badge{display:inline-block;border-radius:9999px;background:var(--brand-gold);color:var(--brand-navy);padding:.25rem .75rem;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:1rem}
.event-hero-title{font-size:2.5rem;font-weight:700;line-height:1;letter-spacing:-.03em;margin-bottom:.5rem}
@media(min-width:640px){.event-hero-title{font-size:3.5rem}}
.event-hero-venue{font-size:1.125rem;color:var(--muted-foreground)}
.event-details{display:grid;gap:1rem;margin-bottom:2.5rem}
@media(min-width:640px){.event-details{grid-template-columns:repeat(3,1fr)}}
.detail-card{display:flex;align-items:flex-start;gap:.75rem;border-radius:1rem;border:1px solid var(--border);background:var(--card);padding:1.25rem}
.detail-icon{color:var(--brand-gold);flex-shrink:0}
.detail-label{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-foreground);margin-bottom:.25rem}
.detail-value{font-weight:600;font-size:.9375rem}
.event-actions{display:flex;flex-wrap:wrap;gap:1rem}
.action-btn{display:inline-flex;align-items:center;gap:.5rem;border-radius:9999px;padding:.75rem 1.5rem;font-size:.875rem;font-weight:600;color:var(--neon-foreground);box-shadow:0 10px 40px -10px var(--brand-gold);transition:transform .2s}
.action-btn:hover{transform:translateY(-1px)}
.action-btn-secondary{display:inline-flex;align-items:center;border-radius:9999px;border:1px solid var(--border);background:var(--card);padding:.75rem 1.5rem;font-size:.875rem;font-weight:500;color:var(--muted-foreground);transition:background .2s,color .2s}
.action-btn-secondary:hover{background:var(--secondary);color:var(--foreground)}
.map-link{color:var(--foreground);text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:4px;transition:color .2s,text-decoration-color .2s}
.map-link:hover{color:var(--brand-gold);text-decoration-color:var(--brand-gold)}
</style>
