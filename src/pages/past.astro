---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventFilterBar from '../components/EventFilterBar.astro';
import EventJsonLd from '../components/EventJsonLd.astro';
import Newsletter from '../components/Newsletter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { events } from '../data/events';
import { formatFullTime } from '../utils/date';

import { Music, Smile, PartyPopper, Theater, Users, Tent, MapPin, Building, Mic2 } from 'lucide-astro';

const today = new Date().toISOString().slice(0, 10);
const pastEvents = events.filter(e => e.date < today);

// Sort past events by date descending (newest first)
const sortedEvents = [...pastEvents].sort((a, b) => {
  const d = b.date.localeCompare(a.date);
  if (d !== 0) return d;
  return b.time.localeCompare(a.time);
});

// Group by Date
const eventsByDate: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByDate[e.date]) eventsByDate[e.date] = [];
  eventsByDate[e.date].push(e);
}
const sortedDates = Object.keys(eventsByDate).sort().reverse();

// Group by City
const eventsByCity: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByCity[e.city]) eventsByCity[e.city] = [];
  eventsByCity[e.city].push(e);
}
const sortedCities = Object.keys(eventsByCity).sort();

// Group by Venue
const eventsByVenue: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByVenue[e.venue]) eventsByVenue[e.venue] = [];
  eventsByVenue[e.venue].push(e);
}
const sortedVenues = Object.keys(eventsByVenue).sort();

// Group by Category
const eventsByCategory: Record<string, typeof events> = {};
for (const e of sortedEvents) {
  if (!eventsByCategory[e.category]) eventsByCategory[e.category] = [];
  eventsByCategory[e.category].push(e);
}
const sortedCategories = Object.keys(eventsByCategory).sort();

const categoryIcons: Record<string, any> = {
  music: Music,
  comedy: Smile,
  dance: PartyPopper,
  theatre: Theater,
  community: Users,
  festival: Tent,
};

const formatCategoryName = (cat: string) => {
  const names: Record<string, string> = {
    music: "Live Music",
    comedy: "Comedy",
    dance: "Dance",
    theatre: "Theatre & Arts",
    community: "Community",
    festival: "Festivals"
  };
  return names[cat] || cat;
};

const formatDayHeader = (dateStr: string) => {
  if (!dateStr) return '';
  const [y, m, d] = dateStr.split('-').map(Number);
  const dateObj = new Date(Date.UTC(y, m - 1, d, 12, 0, 0));
  const weekday = dateObj.toLocaleDateString('en-US', { weekday: 'short', timeZone: 'UTC' }).toUpperCase();
  const month = dateObj.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
  return `${weekday} · ${month} ${d}, ${y}`;
};
---

<Layout title="Past Concerts & Event History — AK Concerts" description="Browse historical concerts, live music, comedy and festival listings across Alaska from 2019 to today.">
  <EventJsonLd events={sortedEvents} />
  <SiteHeader />
  <main class="past-events-page">
    <section class="events-section container">
      <div class="past-header">
        <p class="past-eyebrow">Concert Archive</p>
        <h1 class="past-title font-display">Past Events History</h1>
        <p class="past-sub">Search and explore {pastEvents.length.toLocaleString()} historical concerts & events across Alaska.</p>
        
        <!-- Archive Discovery Quick Links -->
        <div class="archive-discovery-bar">
          <span class="discovery-label">Quick Jump:</span>
          <a href="/cities/anchorage" class="discovery-pill"><MapPin size={12} /> Anchorage Archive</a>
          <a href="/cities/fairbanks" class="discovery-pill"><MapPin size={12} /> Fairbanks Archive</a>
          <a href="/cities/juneau" class="discovery-pill"><MapPin size={12} /> Juneau Archive</a>
          <a href="/venues" class="discovery-pill"><Building size={12} /> Top Venues</a>
          <a href="/bands" class="discovery-pill"><Mic2 size={12} /> Artist Directory</a>
        </div>
      </div>

      <!-- Global Filter & Search Bar -->
      <EventFilterBar events={sortedEvents} showTimelineFilter={false} />

      <!-- View: Date (Grouped by Day) -->
      <div id="view-date" class="events-view-container" style="display: block;">
        {sortedDates.map(dateKey => (
          <div class="day-block group-block" data-date={dateKey}>
            <div class="day-header-badge">
              <span class="day-header-title">{formatDayHeader(dateKey)}</span>
            </div>
            <div class="event-list">
              {eventsByDate[dateKey].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row archive-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-venue-city">{e.venue} · {e.city}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- View: City -->
      <div id="view-city" class="events-view-container" style="display: none;">
        {sortedCities.map(city => (
          <div class="city-block group-block">
            <h3 class="city-name font-display">{city}</h3>
            <div class="event-list">
              {eventsByCity[city].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row archive-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-venue-city">{e.venue}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- View: Venue -->
      <div id="view-venue" class="events-view-container" style="display: none;">
        {sortedVenues.map(venue => (
          <div class="venue-block group-block">
            <h3 class="city-name font-display event-row-venue" data-city={eventsByVenue[venue][0].city} style="display:inline-block;">{venue}</h3> <span style="font-size: 1rem; color: var(--muted-foreground); margin-left: .5rem; font-family: var(--font-sans); font-weight: 500;">{eventsByVenue[venue][0].city}</span>
            <div class="event-list">
              {eventsByVenue[venue].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row archive-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- View: Category -->
      <div id="view-category" class="events-view-container" style="display: none;">
        {sortedCategories.map(cat => (
          <div class="category-block group-block">
            <h3 class="city-name font-display">{formatCategoryName(cat)}</h3>
            <div class="event-list">
              {eventsByCategory[cat].map(e => {
                const Icon = categoryIcons[e.category] || Music;
                return (
                  <a 
                    href={`/events/${e.slug}`} 
                    class="event-row archive-row"
                    data-city={e.city}
                    data-date={e.date}
                    data-venue={e.venue}
                    data-category={e.category}
                  >
                    <span class="event-row-icon"><Icon size={14} /></span>
                    <span class="event-row-date">{e.date}</span>
                    <span class="event-row-title">{e.title}</span>
                    <span class="event-row-venue-city">{e.venue} · {e.city}</span>
                    <span class="event-row-time">{formatFullTime(e.time)}</span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

    </section>

    <Newsletter />
  </main>
  <SiteFooter />
</Layout>

<style>
.past-events-page { padding-block: 1.5rem; }
.past-header { margin-bottom: 2rem; }
.past-eyebrow { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .2em; color: var(--brand-gold); margin-bottom: .35rem; }
.past-title { font-size: 2.25rem; font-weight: 800; letter-spacing: -.03em; margin: 0; }
@media (min-width: 640px) { .past-title { font-size: 3.25rem; } }
.past-sub { margin-top: .35rem; color: var(--muted-foreground); font-size: 0.95rem; }

.archive-discovery-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
  flex-wrap: wrap;
}

.discovery-label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted-foreground);
}

.discovery-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--foreground);
  background: var(--card);
  border: 1px solid var(--border);
  padding: 0.25rem 0.625rem;
  border-radius: 0.375rem;
  text-decoration: none;
  transition: all 0.15s ease;
}

.discovery-pill:hover {
  background: var(--secondary);
  border-color: var(--brand-gold);
  color: var(--brand-gold);
}

.events-section{padding-block:1rem 2rem}
.day-block{margin-bottom:1.75rem}
.day-header-badge{display:flex;align-items:center;gap:.75rem;margin-bottom:.5rem;padding-bottom:.4rem;border-bottom:1px solid color-mix(in oklab, var(--border) 60%, transparent)}
.day-header-title{font-size:0.95rem;font-weight:800;letter-spacing:0.04em;color:var(--brand-gold);text-transform:uppercase;margin:0}

.city-block{margin-bottom:2.5rem}
.city-name{font-size:1.25rem;font-weight:700;color:var(--brand-gold);margin-bottom:.75rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.event-list{display:flex;flex-direction:column;gap:.2rem}

.event-row{
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.625rem 0.85rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  text-decoration: none;
  color: inherit;
  background: transparent;
  border: 1px solid transparent;
  transition: all 0.15s ease;
}

.event-row:nth-child(even) {
  background: rgba(255, 255, 255, 0.015);
}

.event-row:hover {
  background: var(--card);
  border-color: color-mix(in oklab, var(--brand-gold) 30%, transparent);
  transform: translateX(2px);
}

.event-row-icon{font-size:.875rem;flex-shrink:0;color:var(--brand-gold)}
.event-row-date{font-size:.78rem;font-weight:600;color:var(--muted-foreground);min-width:5.25rem;flex-shrink:0}
.event-row-title{font-weight:700;color:#ffffff;flex:1.2;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.event-row-venue-city{font-size:0.8125rem;color:var(--muted-foreground);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.event-row-time{font-size:0.85rem;font-weight:700;color:var(--brand-gold);flex-shrink:0;margin-left:auto}

@media(max-width:767px){
  .event-row{display:flex;flex-direction:column;align-items:flex-start;gap:.35rem;padding:.85rem 1rem;border-radius:.625rem;background:rgba(255,255,255,0.02);border:1px solid var(--border);margin-bottom:.35rem}
  .event-row-icon,.event-row-date{order:1}
  .event-row-venue-city{display:block !important;order:2;font-size:.85rem;color:var(--muted-foreground);font-weight:500}
  .event-row-time{display:block !important;order:2;margin-left:auto;font-size:.9rem;font-weight:700;color:var(--brand-gold)}
  .event-row-title{width:100%;order:3;font-weight:800;font-size:1.05rem;margin-top:.15rem;color:#ffffff;line-height:1.35;white-space:normal}
}
</style>
}
</style>
