---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { events } from '../../data/events';
import venuesData from '../../../venues.json';
import { getAlaskaTodayDate, isEventPast, formatFullTime } from '../../utils/date';
import { MapPin, Building, ExternalLink, Calendar, Music, Navigation, Users } from 'lucide-astro';

export function getStaticPaths() {
  const venueMap = new Map();

  const cleanName = (name: string) => {
    return name
      .replace(/^(\d{1,2}(:\d{2})?[ap]?\s*-\s*\d{1,2}(:\d{2})?[ap]?\s*)+/gi, '')
      .replace(/^(\d{1,2}\s*-\s*\d{1,2}\s*)+/g, '')
      .replace(/^(\d+[ap]\s*)+/gi, '')
      .trim();
  };

  // Load from venues.json
  venuesData.forEach(v => {
    const name = cleanName(v.name);
    const slug = (v.id || name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    venueMap.set(slug, {
      slug,
      name,
      city: v.city,
      address: v.address || `${name}, ${v.city}, AK`,
      capacity: v.capacity || null,
      website: v.website || '',
      facebookUrl: v.facebookUrl || '',
      lat: v.lat || null,
      lng: v.lng || null
    });
  });

  // Extract from events data
  events.forEach(e => {
    if (!e.venue) return;
    const name = cleanName(e.venue);
    if (!name) return;
    const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    if (!venueMap.has(slug)) {
      venueMap.set(slug, {
        slug,
        name,
        city: e.city,
        address: `${name}, ${e.city}, AK`,
        capacity: null,
        website: '',
        facebookUrl: '',
        lat: null,
        lng: null
      });
    }
  });

  return [...venueMap.values()].map(venue => ({
    params: { slug: venue.slug },
    props: { venue }
  }));
}

const { venue } = Astro.props;

// Find all events for this venue
const venueNameClean = venue.name.toLowerCase().replace(/[^a-z0-9]/g, '');
const venueEvents = events.filter(e => {
  if (!e.venue) return false;
  const eNameClean = e.venue.toLowerCase().replace(/[^a-z0-9]/g, '');
  return eNameClean.includes(venueNameClean) || venueNameClean.includes(eNameClean);
});

const todayDate = getAlaskaTodayDate();
const upcomingEvents = venueEvents.filter(e => e.date >= todayDate).sort((a, b) => a.date.localeCompare(b.date));
const pastEvents = venueEvents.filter(e => e.date < todayDate).sort((a, b) => b.date.localeCompare(a.date));

const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue.address || (venue.name + ', ' + venue.city + ', AK'))}`;
---

<Layout title={`${venue.name} — Live Music Venue in ${venue.city}, AK`} description={`Explore live music, concerts, and events at ${venue.name} in ${venue.city}, Alaska.`}>
  <SiteHeader />
  <main class="venue-detail-page container">
    
    <!-- Breadcrumbs -->
    <nav class="venue-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> &rsaquo;
      <a href="/venues">Venues</a> &rsaquo;
      <span aria-current="page">{venue.name}</span>
    </nav>

    <!-- Venue Hero Card -->
    <div class="venue-hero">
      <div class="venue-hero-info">
        <span class="venue-city-badge"><MapPin size={14} /> {venue.city}, Alaska</span>
        <h1 class="venue-title font-display">{venue.name}</h1>
        <p class="venue-address">📍 {venue.address}</p>

        <div class="venue-badges-row">
          {venue.capacity && (
            <span class="venue-badge"><Users size={14} /> Capacity: <strong>{venue.capacity}</strong> guests</span>
          )}
          <span class="venue-badge"><Calendar size={14} /> <strong>{venueEvents.length}</strong> Total Shows</span>
        </div>

        <div class="venue-actions">
          {venue.website && (
            <a href={venue.website} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              🌐 Official Website <ExternalLink size={14} />
            </a>
          )}
          {venue.facebookUrl && (
            <a href={venue.facebookUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              📘 Facebook Events <ExternalLink size={14} />
            </a>
          )}
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            📍 Directions on Map <ExternalLink size={14} />
          </a>
        </div>
      </div>
    </div>

    <!-- Map & Show List Grid -->
    <div class="venue-content-grid">
      
      <!-- Left / Main Column: Shows List -->
      <div class="venue-shows-column">
        <h2 class="section-title font-display">Upcoming Live Shows</h2>
        {upcomingEvents.length > 0 ? (
          <div class="event-list">
            {upcomingEvents.map(e => (
              <a href={`/events/${e.slug}`} class="venue-event-card">
                <div class="card-row-1">
                  <span class="event-date">{e.date}</span>
                  <span class="event-time">{formatFullTime(e.time)}</span>
                </div>
                <div class="card-row-2">
                  <h3 class="event-title">{e.title}</h3>
                </div>
                <div class="card-row-3">
                  <span class="event-cat">{e.category}</span>
                  <span class="event-link-text">View Event &rarr;</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p class="no-events-msg">No upcoming shows currently scheduled for {venue.name}. Check past shows below.</p>
        )}

        {pastEvents.length > 0 && (
          <div class="past-shows-block">
            <h3 class="section-subtitle font-display">Past Shows History ({pastEvents.length})</h3>
            <div class="event-list">
              {pastEvents.slice(0, 20).map(e => (
                <a href={`/events/${e.slug}`} class="venue-event-card past-card">
                  <div class="card-row-1">
                    <span class="event-date">{e.date}</span>
                    <span class="past-pill">PAST SHOW</span>
                    <span class="event-time">{formatFullTime(e.time)}</span>
                  </div>
                  <div class="card-row-2">
                    <h4 class="event-title">{e.title}</h4>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Interactive Map Widget -->
      <div class="venue-sidebar">
        <div class="venue-map-card">
          <h3 class="sidebar-title font-display">Venue Map Location</h3>
          <div class="sidebar-map-box">
            <div id="venue-leaflet-map"></div>
          </div>
          <p class="map-hint">📍 {venue.address}</p>
          <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="map-link-btn">
            Open in Google Maps &rarr;
          </a>
        </div>

        <div class="city-nav-box">
          <h4 class="sidebar-title font-display">Explore {venue.city}</h4>
          <p class="city-nav-desc">See all live concerts and events taking place across {venue.city}.</p>
          <a href={`/cities/${venue.city.toLowerCase().replace(/\s+/g, '-')}`} class="city-nav-btn font-display">
            View All {venue.city} Events &rarr;
          </a>
        </div>
      </div>

    </div>

  </main>
  <SiteFooter />
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script is:inline define:vars={{ venue }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mapElement = document.getElementById('venue-leaflet-map');
    if (!mapElement || typeof L === 'undefined') return;

    const lat = venue.lat || 61.2181;
    const lng = venue.lng || -149.9003;

    const map = L.map('venue-leaflet-map', {
      center: [lat, lng],
      zoom: 14,
      scrollWheelZoom: false
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    const customIcon = L.divIcon({
      className: 'custom-venue-pin',
      html: `<div class="pin-marker"><span class="pin-dot"></span></div>`,
      iconSize: [24, 24],
      iconAnchor: [12, 12]
    });

    const marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
    marker.bindPopup(`<strong>${venue.name}</strong><br/>${venue.address}`).openPopup();
  });
</script>

<style>
.venue-detail-page { padding-block: 2rem 4rem; }

.venue-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  color: var(--muted-foreground);
  margin-bottom: 1.5rem;
}
.venue-breadcrumb a { color: var(--muted-foreground); text-decoration: none; }
.venue-breadcrumb a:hover { color: var(--brand-gold); }

.venue-hero {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 1.25rem;
  padding: 2rem;
  margin-bottom: 2.5rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.3);
}

.venue-city-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--brand-gold);
  margin-bottom: 0.5rem;
}

.venue-title {
  font-size: 2.5rem;
  font-weight: 800;
  margin: 0 0 0.5rem 0;
  color: #fff;
}

.venue-address {
  font-size: 1rem;
  color: var(--muted-foreground);
  margin-bottom: 1.25rem;
}

.venue-badges-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.venue-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  padding: 0.4rem 0.85rem;
  border-radius: 9999px;
  font-size: 0.85rem;
  color: var(--foreground);
}

.venue-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s;
  cursor: pointer;
}
.btn-primary { background: var(--brand-gold); color: var(--brand-navy); }
.btn-primary:hover { background: #e0b84c; }
.btn-secondary { background: #1e293b; color: #fff; border: 1px solid var(--border); }
.btn-secondary:hover { background: #334155; }
.btn-outline { background: transparent; color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.4); }
.btn-outline:hover { background: rgba(56, 189, 248, 0.15); }

.venue-content-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2.5rem;
}
@media (min-width: 1024px) {
  .venue-content-grid {
    grid-template-columns: 1fr 340px;
  }
}

.section-title { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem; color: #fff; }
.section-subtitle { font-size: 1.25rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 1rem; color: var(--muted-foreground); }

.event-list { display: flex; flex-direction: column; gap: 0.75rem; }

.venue-event-card {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  padding: 1rem 1.25rem;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 0.875rem;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s;
}
.venue-event-card:hover {
  border-color: var(--brand-gold);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
}

.card-row-1 { display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; }
.event-date { font-weight: 700; color: var(--brand-gold); }
.event-time { font-weight: 700; color: var(--brand-gold); }
.past-pill { font-size: 0.65rem; font-weight: 700; background: rgba(239,68,68,0.18); border: 1px solid rgba(239,68,68,0.5); color: #ef4444; padding: 0.1rem 0.35rem; border-radius: 0.25rem; }

.card-row-2 .event-title { font-size: 1.1rem; font-weight: 800; color: #fff; margin: 0; }
.card-row-3 { display: flex; align-items: center; justify-content: space-between; font-size: 0.75rem; margin-top: 0.2rem; }
.event-cat { text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted-foreground); font-weight: 600; }
.event-link-text { color: #38bdf8; font-weight: 700; }

.past-card { opacity: 0.75; }
.past-card:hover { opacity: 1; }

.no-events-msg { color: var(--muted-foreground); font-style: italic; background: var(--card); padding: 1.5rem; border-radius: 0.75rem; border: 1px dashed var(--border); }

/* Sidebar Map Widget */
.venue-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
.venue-map-card, .city-nav-box {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 1.25rem;
}

.sidebar-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.85rem; color: #fff; }
.sidebar-map-box { height: 220px; border-radius: 0.75rem; overflow: hidden; border: 1px solid var(--border); margin-bottom: 0.75rem; }
#venue-leaflet-map { width: 100%; height: 100%; }

.map-hint { font-size: 0.8rem; color: var(--muted-foreground); margin-bottom: 0.75rem; }
.map-link-btn, .city-nav-btn {
  display: block;
  text-align: center;
  padding: 0.625rem;
  border-radius: 0.5rem;
  font-size: 0.85rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.15s;
}
.map-link-btn { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
.map-link-btn:hover { background: #38bdf8; color: #0f172a; }

.city-nav-desc { font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 1rem; }
.city-nav-btn { background: var(--brand-gold); color: var(--brand-navy); }
.city-nav-btn:hover { background: #e0b84c; }

:global(.custom-venue-pin) { background: transparent; border: none; }
:global(.pin-marker) {
  width: 20px;
  height: 20px;
  background: #38bdf8;
  border: 3px solid #0f172a;
  border-radius: 50%;
  box-shadow: 0 0 10px #38bdf8, 0 0 20px #38bdf8;
}
</style>
