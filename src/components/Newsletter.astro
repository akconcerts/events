---
import { Mail, Sparkles, CheckCircle2 } from 'lucide-astro';
---

<section class="newsletter-section container">
  <div class="newsletter-poster">
    <div class="poster-border-inner"></div>
    <div class="newsletter-inner">
      <div class="poster-badge"><Sparkles size={13} /> ALASKA'S WEEKLY CONCERT BRIEF</div>
      
      <div class="newsletter-copy">
        <span class="newsletter-eyebrow">THE FRIDAY DROP</span>
        <h2 class="newsletter-title font-display">Every Alaska show, in your inbox before the weekend.</h2>
        <p class="newsletter-sub">One email every Thursday afternoon. No fluff. Just what's worth leaving the house for.</p>
        
        <div class="newsletter-bullets">
          <span class="bullet-item"><CheckCircle2 size={14} class="text-gold" /> Weekend Highlight Reel</span>
          <span class="bullet-item"><CheckCircle2 size={14} class="text-gold" /> Newly Announced Tours</span>
          <span class="bullet-item"><CheckCircle2 size={14} class="text-gold" /> Free Show Alerts</span>
        </div>
      </div>

      <form class="newsletter-form" onsubmit="event.preventDefault()">
        <div class="input-wrap">
          <Mail size={16} class="mail-icon" />
          <input type="email" required placeholder="Enter your email address..." class="newsletter-input" />
        </div>
        <button type="submit" class="newsletter-btn bg-gradient-gold">Join The Drop</button>
      </form>
    </div>
  </div>
</section>

<style>
.newsletter-section {
  padding-block: 3.5rem 5rem;
}

.newsletter-poster {
  position: relative;
  overflow: hidden;
  border-radius: 1.5rem;
  background: radial-gradient(120% 120% at 50% 0%, #162032 0%, #0b1019 100%);
  border: 2px solid color-mix(in oklab, var(--brand-gold) 45%, var(--border));
  padding: 2.5rem 1.5rem;
  box-shadow: 0 16px 50px rgba(0, 0, 0, 0.5);
}

@media(min-width: 640px) {
  .newsletter-poster { padding: 3.5rem; }
}

.poster-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--brand-gold);
  background: rgba(204, 164, 59, 0.12);
  border: 1px solid rgba(204, 164, 59, 0.3);
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  margin-bottom: 1rem;
}

.newsletter-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  max-width: 42rem;
  margin: 0 auto;
}

.newsletter-eyebrow {
  display: block;
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.25em;
  color: var(--brand-gold);
  margin-bottom: 0.5rem;
}

.newsletter-title {
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.025em;
  color: #ffffff;
  margin: 0 0 0.75rem 0;
}

@media(min-width: 640px) {
  .newsletter-title { font-size: 2.75rem; }
}

.newsletter-sub {
  font-size: 1rem;
  color: var(--muted-foreground);
  margin: 0 0 1.25rem 0;
}

.newsletter-bullets {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.25rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  font-size: 0.8125rem;
  font-weight: 600;
  color: #ffffff;
}

.bullet-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.text-gold {
  color: var(--brand-gold);
}

.newsletter-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 100%;
  max-width: 32rem;
}

@media(min-width: 640px) {
  .newsletter-form {
    flex-direction: row;
  }
}

.input-wrap {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.mail-icon {
  position: absolute;
  left: 1rem;
  color: var(--muted-foreground);
  pointer-events: none;
}

.newsletter-input {
  width: 100%;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  background: rgba(10, 14, 23, 0.8);
  color: #ffffff;
  padding: 0.75rem 1rem 0.75rem 2.6rem;
  font-size: 0.875rem;
  outline: none;
  transition: border-color 0.2s;
}

.newsletter-input:focus {
  border-color: var(--brand-gold);
}

.newsletter-btn {
  border-radius: 0.75rem;
  padding: 0.75rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--brand-navy);
  white-space: nowrap;
  border: none;
  cursor: pointer;
  transition: transform 0.15s;
}

.newsletter-btn:hover {
  transform: translateY(-1px);
}
</style>
