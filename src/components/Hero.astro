---
import { events, cities } from '../data/events';

const heroImages = [
  '/images/hero/hero-01.webp',
  '/images/hero/hero-02.webp',
  '/images/hero/hero-03.webp',
  '/images/hero/hero-04.webp',
  '/images/hero/hero-05.webp',
  '/images/hero/hero-06.webp',
  '/images/hero/hero-07.webp',
  '/images/hero/hero-08.webp',
  '/images/hero/hero-09.webp',
  '/images/hero/hero-10.webp',
  '/images/hero/hero-11.webp',
  '/images/hero/hero-12.webp',
  '/images/hero/hero-13.webp',
  '/images/hero/hero-14.webp',
  '/images/hero/hero-15.webp',
  '/images/hero/hero-16.webp',
  '/images/hero/hero-17.webp',
  '/images/hero/hero-18.webp',
  '/images/hero/hero-19.webp',
  '/images/hero/hero-20.webp'
];

const defaultHero = '/images/hero/hero-20.webp';
---

<section class="hero">
  <div class="hero-bg">
    <img
      id="ak-hero-image"
      src={defaultHero}
      alt=""
      width="2400"
      height="1350"
      class="hero-img"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay-gradient"></div>
    <div class="hero-overlay-aurora bg-aurora"></div>
  </div>
  <div class="hero-content container">
    <div class="live-badge">
      <span class="live-indicator"><span class="live-dot-outer live-dot"></span><span class="live-dot-inner"></span></span>
      Live across Alaska tonight
    </div>
    <h1 class="hero-title font-display">What's happening <span class="text-gradient-gold">tonight</span><br class="hero-br" /> in Alaska.</h1>
    <p class="hero-subtitle">The statewide source of truth for live music, comedy and festivals — from Anchorage to Fairbanks to the Kenai. Curated daily.</p>
    <div class="hero-cta">
      <a href="#tonight" class="btn-primary bg-gradient-gold">See what's on tonight <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
      <a href="/bands" class="btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg> Alaska Bands</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><div class="stat-number font-display">{events.length}</div><div class="stat-label">Events listed</div></div>
      <div class="stat"><div class="stat-number font-display">{[...new Set(events.map(e => e.venue))].length}</div><div class="stat-label">Venues</div></div>
      <div class="stat"><div class="stat-number font-display">{cities.length}</div><div class="stat-label">Cities</div></div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var heroList = [
      '/images/hero/hero-01.webp',
      '/images/hero/hero-02.webp',
      '/images/hero/hero-03.webp',
      '/images/hero/hero-04.webp',
      '/images/hero/hero-05.webp',
      '/images/hero/hero-06.webp',
      '/images/hero/hero-07.webp',
      '/images/hero/hero-08.webp',
      '/images/hero/hero-09.webp',
      '/images/hero/hero-10.webp',
      '/images/hero/hero-11.webp',
      '/images/hero/hero-12.webp',
      '/images/hero/hero-13.webp',
      '/images/hero/hero-14.webp',
      '/images/hero/hero-15.webp',
      '/images/hero/hero-16.webp',
      '/images/hero/hero-17.webp',
      '/images/hero/hero-18.webp',
      '/images/hero/hero-19.webp',
      '/images/hero/hero-20.webp'
    ];
    
    try {
      var selected = sessionStorage.getItem('ak_hero_selected');
      if (!selected || heroList.indexOf(selected) === -1) {
        selected = heroList[Math.floor(Math.random() * heroList.length)];
        sessionStorage.setItem('ak_hero_selected', selected);
      }
      var imgElem = document.getElementById('ak-hero-image');
      if (imgElem) {
        imgElem.src = selected;
      }
    } catch(e) {}
  })();
</script>

<style>
.hero {
  position: relative;
  overflow: hidden;
  min-height: 80vh;
  display: flex;
  align-items: center;
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center right;
  opacity: 0.75;
  transition: opacity 0.4s ease-in-out;
}
.hero-overlay-gradient {
  position: absolute;
  inset: 0;
  background: 
    linear-gradient(90deg, rgba(10,14,23,0.92) 0%, rgba(10,14,23,0.85) 45%, rgba(10,14,23,0.45) 75%, rgba(10,14,23,0.2) 100%),
    linear-gradient(to top, var(--background) 0%, rgba(10,14,23,0.5) 40%, transparent 100%);
}
.hero-overlay-aurora {
  position: absolute;
  inset: 0;
  opacity: 0.35;
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding-top: 5rem;
  padding-bottom: 4rem;
  width: 100%;
}
@media(min-width:640px){.hero-content{padding-top:7rem;padding-bottom:6rem}}
@media(min-width:1024px){.hero-content{padding-top:9rem}}
.live-badge{display:inline-flex;align-items:center;gap:.5rem;width:fit-content;border-radius:9999px;border:1px solid color-mix(in oklab,var(--border) 60%,transparent);background:color-mix(in oklab,var(--card) 60%,transparent);padding:.25rem .75rem;font-size:.75rem;font-weight:500;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-foreground);backdrop-filter:blur(8px)}
.live-indicator{position:relative;display:flex;width:.5rem;height:.5rem}
.live-dot-outer{position:absolute;width:100%;height:100%;border-radius:9999px;background:var(--neon);opacity:.75}
.live-dot-inner{position:relative;display:inline-flex;width:.5rem;height:.5rem;border-radius:9999px;background:var(--neon)}
.hero-title{max-width:56rem;font-size:3rem;font-weight:700;line-height:.95;letter-spacing:-.025em}
@media(min-width:640px){.hero-title{font-size:3.75rem}}
@media(min-width:1024px){.hero-title{font-size:6rem}}
.hero-br{display:none}
@media(min-width:640px){.hero-br{display:block}}
.hero-subtitle{max-width:36rem;font-size:1rem;color:var(--muted-foreground)}
@media(min-width:640px){.hero-subtitle{font-size:1.125rem}}
.hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:.75rem}
.btn-primary{display:inline-flex;align-items:center;gap:.5rem;border-radius:9999px;padding:.75rem 1.5rem;font-size:.875rem;font-weight:600;color:var(--neon-foreground);box-shadow:0 10px 40px -10px var(--neon);transition:transform .2s}
.btn-primary:hover{transform:translateY(-1px)}
.btn-secondary{display:inline-flex;align-items:center;gap:.5rem;border-radius:9999px;border:1px solid var(--border);background:color-mix(in oklab,var(--card) 60%,transparent);padding:.75rem 1.5rem;font-size:.875rem;font-weight:600;color:var(--foreground);backdrop-filter:blur(8px);transition:background .2s}
.btn-secondary:hover{background:var(--secondary)}
.hero-stats{margin-top:2rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;border-top:1px solid color-mix(in oklab,var(--border) 40%,transparent);padding-top:2rem}
@media(min-width:640px){.hero-stats{max-width:28rem}}
.stat-number{font-size:1.5rem;font-weight:700}
@media(min-width:640px){.stat-number{font-size:1.875rem}}
.stat-label{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-foreground)}
</style>
