---
import { events, cities } from '../data/events';
import { getAlaskaDaysAgoDate, getAlaskaDaysAheadDate } from '../utils/date';

const heroImages = [
  '/images/hero/hero-01.webp',
  '/images/hero/hero-02.webp',
  '/images/hero/hero-03.webp',
  '/images/hero/hero-04.webp',
  '/images/hero/hero-05.webp',
  '/images/hero/hero-06.webp',
  '/images/hero/hero-07.webp',
  '/images/hero/hero-08.webp',
  '/images/hero/hero-09.webp',
  '/images/hero/hero-10.webp',
  '/images/hero/hero-11.webp',
  '/images/hero/hero-12.webp',
  '/images/hero/hero-13.webp',
  '/images/hero/hero-14.webp',
  '/images/hero/hero-15.webp',
  '/images/hero/hero-16.webp',
  '/images/hero/hero-17.webp',
  '/images/hero/hero-18.webp',
  '/images/hero/hero-19.webp',
  '/images/hero/hero-20.webp'
];

const defaultHero = '/images/hero/hero-20.webp';
const sevenDaysAgo = getAlaskaDaysAgoDate(7);
const sevenDaysAhead = getAlaskaDaysAheadDate(7);
const eventsThisWeek = events.filter(e => e.date >= sevenDaysAgo && e.date <= sevenDaysAhead).length;
---

<section class="hero">
  <div class="hero-bg">
    <img
      id="ak-hero-image"
      src={defaultHero}
      alt=""
      width="2400"
      height="1350"
      class="hero-img"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay-gradient"></div>
    <div class="hero-overlay-aurora bg-aurora"></div>
  </div>
  <div class="hero-content container">
    <div class="live-badge">
      <span class="live-indicator"><span class="live-dot-outer live-dot"></span><span class="live-dot-inner"></span></span>
      Live across Alaska tonight
    </div>
    <h1 class="hero-title font-display">Find something worth <span class="text-gradient-gold">going out for.</span></h1>
    <p class="hero-subtitle">The statewide source of truth for live music, comedy and festivals — from Anchorage to Fairbanks to the Kenai. Curated daily.</p>
    
    <!-- Hero Universal Search Bar & Location Selector -->
    <div class="hero-search-box">
      <div class="hero-location-select-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="location-icon"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <select id="hero-location-select" class="hero-location-select">
          <option value="all">📍 All Alaska</option>
          {cities.map(c => <option value={c}>📍 {c}</option>)}
        </select>
      </div>

      <div class="hero-search-input-wrap">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input 
          type="search" 
          id="hero-search-input" 
          placeholder="Search bands, venues, events, cities..." 
          autocomplete="off"
        />
        <a href="#playing-soon" class="hero-search-btn bg-gradient-gold">Find Shows</a>
      </div>
    </div>

    <!-- Quick Date Segmented Control -->
    <div class="hero-date-tabs">
      <a href="#tonight" class="hero-date-tab active" data-date="tonight">Tonight</a>
      <a href="#tomorrow" class="hero-date-tab" data-date="tomorrow">Tomorrow</a>
      <a href="#weekend" class="hero-date-tab" data-date="weekend">This Weekend</a>
      <a href="#playing-soon" class="hero-date-tab" data-date="all">All Upcoming</a>
    </div>

    <!-- Subtle One-Line Credibility Strip -->
    <div class="hero-stats-strip">
      <span class="stat-pill"><strong>{events.length.toLocaleString()}+</strong> events listed</span>
      <span class="stat-sep">·</span>
      <span class="stat-pill"><strong>{[...new Set(events.map(e => e.venue))].length}</strong> venues</span>
      <span class="stat-sep">·</span>
      <span class="stat-pill"><strong>{cities.length}</strong> Alaska communities</span>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    var heroList = [
      '/images/hero/hero-01.webp',
      '/images/hero/hero-02.webp',
      '/images/hero/hero-03.webp',
      '/images/hero/hero-04.webp',
      '/images/hero/hero-05.webp',
      '/images/hero/hero-06.webp',
      '/images/hero/hero-07.webp',
      '/images/hero/hero-08.webp',
      '/images/hero/hero-09.webp',
      '/images/hero/hero-10.webp',
      '/images/hero/hero-11.webp',
      '/images/hero/hero-12.webp',
      '/images/hero/hero-13.webp',
      '/images/hero/hero-14.webp',
      '/images/hero/hero-15.webp',
      '/images/hero/hero-16.webp',
      '/images/hero/hero-17.webp',
      '/images/hero/hero-18.webp',
      '/images/hero/hero-19.webp',
      '/images/hero/hero-20.webp'
    ];
    
    try {
      var selected = sessionStorage.getItem('ak_hero_selected');
      if (!selected || heroList.indexOf(selected) === -1) {
        selected = heroList[Math.floor(Math.random() * heroList.length)];
        sessionStorage.setItem('ak_hero_selected', selected);
      }
      var imgElem = document.getElementById('ak-hero-image');
      if (imgElem) {
        imgElem.src = selected;
      }
    } catch(e) {}
  })();
</script>

<style>
.hero {
  position: relative;
  overflow: hidden;
  min-height: 80vh;
  display: flex;
  align-items: center;
}
.hero-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center right;
  opacity: 0.75;
  transition: opacity 0.4s ease-in-out;
}
.hero-overlay-gradient {
  position: absolute;
  inset: 0;
  background: 
    linear-gradient(90deg, rgba(10,14,23,0.92) 0%, rgba(10,14,23,0.85) 45%, rgba(10,14,23,0.45) 75%, rgba(10,14,23,0.2) 100%),
    linear-gradient(to top, var(--background) 0%, rgba(10,14,23,0.5) 40%, transparent 100%);
}
.hero-overlay-aurora {
  position: absolute;
  inset: 0;
  opacity: 0.35;
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding-top: 5rem;
  padding-bottom: 4rem;
  width: 100%;
}
@media(min-width:640px){.hero-content{padding-top:7rem;padding-bottom:6rem}}
@media(min-width:1024px){.hero-content{padding-top:9rem}}
.live-badge{display:inline-flex;align-items:center;gap:.5rem;width:fit-content;border-radius:9999px;border:1px solid color-mix(in oklab,var(--border) 60%,transparent);background:color-mix(in oklab,var(--card) 60%,transparent);padding:.25rem .75rem;font-size:.75rem;font-weight:500;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-foreground);backdrop-filter:blur(8px)}
.live-indicator{position:relative;display:flex;width:.5rem;height:.5rem}
.live-dot-outer{position:absolute;width:100%;height:100%;border-radius:9999px;background:var(--neon);opacity:.75}
.live-dot-inner{position:relative;display:inline-flex;width:.5rem;height:.5rem;border-radius:9999px;background:var(--neon)}
.hero-title{max-width:56rem;font-size:2.75rem;font-weight:800;line-height:.98;letter-spacing:-.03em}
@media(min-width:640px){.hero-title{font-size:3.5rem}}
@media(min-width:1024px){.hero-title{font-size:5rem}}
.hero-subtitle{max-width:38rem;font-size:1rem;color:var(--muted-foreground)}
@media(min-width:640px){.hero-subtitle{font-size:1.125rem}}

/* Hero Search & Location Box */
.hero-search-box {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  max-width: 44rem;
  width: 100%;
  background: rgba(16, 22, 33, 0.75);
  border: 1px solid color-mix(in oklab, var(--brand-gold) 40%, var(--border));
  backdrop-filter: blur(12px);
  padding: 0.5rem;
  border-radius: 1rem;
  box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.6);
}

@media(min-width: 640px) {
  .hero-search-box {
    flex-direction: row;
    align-items: center;
  }
}

.hero-location-select-wrap {
  position: relative;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  border-right: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  padding-right: 0.5rem;
}

@media(max-width: 639px) {
  .hero-location-select-wrap {
    border-right: none;
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
    padding-right: 0;
    padding-bottom: 0.5rem;
  }
}

.hero-location-select-wrap .location-icon {
  position: absolute;
  left: 0.75rem;
  color: var(--brand-gold);
  pointer-events: none;
}

.hero-location-select {
  background: transparent;
  color: var(--foreground);
  border: none;
  font-weight: 700;
  font-size: 0.875rem;
  padding: 0.625rem 0.75rem 0.625rem 2.25rem;
  outline: none;
  cursor: pointer;
}

.hero-search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  flex: 1;
}

.hero-search-icon {
  position: absolute;
  left: 0.75rem;
  color: var(--brand-gold);
  pointer-events: none;
}

.hero-search-input-wrap input {
  width: 100%;
  background: transparent;
  border: none;
  color: var(--foreground);
  font-size: 0.925rem;
  padding: 0.625rem 6.5rem 0.625rem 2.4rem;
  outline: none;
}

.hero-search-btn {
  position: absolute;
  right: 0.25rem;
  padding: 0.5rem 1.125rem;
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--brand-navy);
  border-radius: 0.625rem;
  text-decoration: none;
  transition: transform 0.15s ease;
}

.hero-search-btn:hover {
  transform: translateY(-1px);
}

/* Date Segmented Control Tabs */
.hero-date-tabs {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.hero-date-tab {
  display: inline-flex;
  align-items: center;
  padding: 0.4rem 0.85rem;
  border-radius: 9999px;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--muted-foreground);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border);
  text-decoration: none;
  transition: all 0.15s ease;
}

.hero-date-tab:hover {
  color: var(--foreground);
  background: var(--secondary);
}

.hero-date-tab.active {
  background: var(--brand-gold);
  color: var(--brand-navy);
  font-weight: 700;
  border-color: var(--brand-gold);
}

/* Subtle One-Line Stats Strip */
.hero-stats-strip {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  padding-top: 0.5rem;
  flex-wrap: wrap;
}

.hero-stats-strip strong {
  color: var(--brand-gold);
  font-weight: 700;
}

.stat-sep {
  opacity: 0.4;
}
</style>
