---
import { events } from '../data/events';
import { getAlaskaTodayDate, formatFullTime } from '../utils/date';
import { Flame, Clock, MapPin, Ticket } from 'lucide-astro';

const today = getAlaskaTodayDate();
const tonightEvents = events.filter(e => e.date === today);

// If no events today (or for demo richness), pull next upcoming shows
const displayEvents = tonightEvents.length > 0 ? tonightEvents : events.filter(e => e.date >= today).slice(0, 5);

const heroEvent = displayEvents[0];
const sideEvents = displayEvents.slice(1, 5);
---

<section id="tonight" class="tonight-featured-section container">
  <div class="tonight-header">
    <div class="tonight-title-wrap">
      <span class="tonight-eyebrow"><Flame class="fire-icon" size={14} /> Live Shows Tonight</span>
      <h2 class="tonight-title font-display">Tonight in Alaska</h2>
    </div>
    <a href="#playing-soon" class="view-all-link">See full feed →</a>
  </div>

  {heroEvent && (
    <div class="tonight-grid">
      <!-- Large Featured Event Card -->
      <a href={`/events/${heroEvent.slug}`} class="featured-card">
        <div class="featured-bg-glow"></div>
        <div class="featured-content">
          <div class="featured-badges">
            <span class="badge-featured">FEATURED TONIGHT</span>
            <span class="badge-city">{heroEvent.city}</span>
          </div>
          <h3 class="featured-event-title font-display">{heroEvent.title}</h3>
          <p class="featured-venue"><MapPin size={14} /> {heroEvent.venue}</p>
          <div class="featured-meta">
            <span class="featured-time"><Clock size={14} /> {formatFullTime(heroEvent.time)}</span>
            <span class="featured-cta">View Details →</span>
          </div>
        </div>
      </a>

      <!-- Side Cards Rail -->
      <div class="side-cards-rail">
        {sideEvents.map((e) => (
          <a href={`/events/${e.slug}`} class="side-card">
            <div class="side-card-info">
              <div class="side-card-top">
                <span class="side-city-pill">{e.city}</span>
                <span class="side-time">{formatFullTime(e.time)}</span>
              </div>
              <h4 class="side-title">{e.title}</h4>
              <p class="side-venue"><MapPin size={12} /> {e.venue}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</section>

<style>
.tonight-featured-section {
  padding-block: 2.5rem 1.5rem;
}

.tonight-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 1.5rem;
}

.tonight-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #ff6700;
}

.fire-icon {
  color: #ff6700;
}

.tonight-title {
  font-size: 1.85rem;
  font-weight: 800;
  margin: 0.2rem 0 0 0;
  letter-spacing: -0.02em;
}

.view-all-link {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--brand-gold);
  text-decoration: none;
  transition: color 0.15s;
}

.view-all-link:hover {
  color: #ffffff;
}

.tonight-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}

@media(min-width: 900px) {
  .tonight-grid {
    grid-template-columns: 1.35fr 1fr;
  }
}

/* Featured Large Card */
.featured-card {
  position: relative;
  overflow: hidden;
  border-radius: 1.25rem;
  background: radial-gradient(120% 120% at 0% 0%, #162032 0%, #0b1019 100%);
  border: 1px solid color-mix(in oklab, var(--brand-gold) 35%, transparent);
  padding: 2rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 280px;
  text-decoration: none;
  color: inherit;
  transition: all 0.25s ease;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.featured-card:hover {
  transform: translateY(-2px);
  border-color: var(--brand-gold);
  box-shadow: 0 16px 40px rgba(204, 164, 59, 0.15);
}

.featured-badges {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.badge-featured {
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  background: var(--brand-gold);
  color: var(--brand-navy);
  padding: 0.2rem 0.6rem;
  border-radius: 0.375rem;
}

.badge-city {
  font-size: 0.72rem;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  padding: 0.2rem 0.6rem;
  border-radius: 0.375rem;
}

.featured-event-title {
  font-size: 1.75rem;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 0.5rem 0;
  line-height: 1.15;
}

.featured-venue {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.95rem;
  color: var(--muted-foreground);
  margin: 0 0 1.25rem 0;
}

.featured-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
  padding-top: 1rem;
}

.featured-time {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--brand-gold);
}

.featured-cta {
  font-size: 0.85rem;
  font-weight: 700;
  color: #ffffff;
}

/* Side Cards Rail */
.side-cards-rail {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.side-card {
  display: block;
  background: #0b1019;
  border: 1px solid var(--border);
  border-radius: 0.875rem;
  padding: 1rem;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s ease;
}

.side-card:hover {
  background: #111827;
  border-color: color-mix(in oklab, var(--brand-gold) 40%, transparent);
  transform: translateX(3px);
}

.side-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.35rem;
}

.side-city-pill {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  background: var(--secondary);
  color: var(--muted-foreground);
  padding: 0.15rem 0.45rem;
  border-radius: 0.25rem;
}

.side-time {
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--brand-gold);
}

.side-title {
  font-size: 1rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0 0 0.25rem 0;
  line-height: 1.25;
}

.side-venue {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  margin: 0;
}
</style>
