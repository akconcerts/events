---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
}
const { eyebrow, title, href } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="sh-eyebrow">{eyebrow}</p>
    <h2 class="sh-title font-display">{title}</h2>
  </div>
  {href && (
    <a href={href} class="sh-link">See all <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
  )}
</div>

<style>
.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}
.sh-eyebrow{font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.2em;color:var(--cyan)}
.sh-title{margin-top:.5rem;font-size:1.5rem;font-weight:700;letter-spacing:-.025em}
@media(min-width:640px){.sh-title{font-size:2.25rem}}
.sh-link{display:none;align-items:center;gap:.25rem;flex-shrink:0;font-size:.875rem;color:var(--muted-foreground);transition:color .2s}
.sh-link:hover{color:var(--foreground)}
@media(min-width:640px){.sh-link{display:inline-flex}}
</style>
