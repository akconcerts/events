          <path d="M146.247,113.004c0,1.545-.558,2.808-1.684,3.787-1.12.983-2.452,1.473-3.997,1.473h-31.952s0,23.985,0,23.985h37.002c3.366,0,6.558-.595,9.572-1.789,3.018-1.189,5.682-2.804,7.995-4.839,2.315-2.032,4.14-4.418,5.47-7.153,1.336-2.735,1.999-5.645,1.999-8.732v-10.32s-24.406,0-24.406,0v3.588Z"></path>
        </g>
      </svg>
    </a>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  padding-bottom: 2rem;
}
.footer-inner {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-block: 2.5rem 1.5rem;
}
.footer-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.footer-brand {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}
.footer-name {
  font-weight: 700;
  font-size: 1.125rem;
}
.footer-social-links {
  display: flex;
  align-items: center;
  gap: 0.875rem;
}
.social-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.625rem;
  height: 2.625rem;
  border-radius: 50%;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--muted-foreground);
  transition: color .2s, border-color .2s, background .2s, transform .2s;
  text-decoration: none;
}
.social-icon-btn:hover {
  transform: translateY(-2px);
}
.social-fb:hover {
  color: #1877F2;
  border-color: #1877F2;
  background: rgba(24, 119, 242, 0.12);
}
.social-ig:hover {
  color: #E4405F;
  border-color: #E4405F;
  background: rgba(228, 64, 95, 0.12);
}
.social-sc:hover {
  color: #FFFC00;
  border-color: #FFFC00;
  background: rgba(255, 252, 0, 0.12);
}

.footer-bottom-row {
  display: flex;
  flex-direction: column-reverse;
  gap: 1rem;
  padding-top: 1rem;
  border-top: 1px solid color-mix(in oklab, var(--border) 30%, transparent);
}
@media (min-width: 640px) {
  .footer-bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.footer-copy {
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  margin: 0;
}

.footer-links {
  display: flex;
  gap: 1.25rem;
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  flex-wrap: wrap;
}
.footer-links a {
  text-decoration: none;
  color: inherit;
  transition: color 0.2s;
}
.footer-links a:hover {
  color: var(--brand-gold);
}

.designer-credit {
  margin-top: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
}
.designer-credit span {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--muted-foreground);
}
.designer-credit a {
  display: block;
  outline: none;
  border-radius: 4px;
}
.designer-credit svg {
  height: 2rem;
  width: auto;
  fill: var(--muted-foreground);
  transition: fill 0.3s;
}
.designer-credit a:hover svg {
  fill: #ff6700;
}
</style>
