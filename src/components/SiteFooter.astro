<style>
.site-footer {
  border-top: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  padding-bottom: 2rem;
}
.footer-inner {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding-block: 2.5rem 1.5rem;
}
.footer-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.footer-brand {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}
.footer-name {
  font-weight: 700;
  font-size: 1.125rem;
}
.footer-social-links {
  display: flex;
  align-items: center;
  gap: 0.875rem;
}
.social-icon-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.625rem;
  height: 2.625rem;
  border-radius: 50%;
  background: var(--card);
  border: 1px solid var(--border);
  color: var(--muted-foreground);
  transition: color .2s, border-color .2s, background .2s, transform .2s;
  text-decoration: none;
}
.social-icon-btn:hover {
  transform: translateY(-2px);
}
.social-fb:hover {
  color: #1877F2;
  border-color: #1877F2;
  background: rgba(24, 119, 242, 0.12);
}
.social-ig:hover {
  color: #E4405F;
  border-color: #E4405F;
  background: rgba(228, 64, 95, 0.12);
}
.social-sc:hover {
  color: #FFFC00;
  border-color: #FFFC00;
  background: rgba(255, 252, 0, 0.12);
}

.footer-bottom-row {
  display: flex;
  flex-direction: column-reverse;
  gap: 1rem;
  padding-top: 1rem;
  border-top: 1px solid color-mix(in oklab, var(--border) 30%, transparent);
}
@media (min-width: 640px) {
  .footer-bottom-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.footer-copy {
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  margin: 0;
}

.footer-links {
  display: flex;
  gap: 1.25rem;
  font-size: 0.8125rem;
  color: var(--muted-foreground);
  flex-wrap: wrap;
}
.footer-links a {
  text-decoration: none;
  color: inherit;
  transition: color 0.2s;
}
.footer-links a:hover {
  color: var(--brand-gold);
}

.designer-credit-container {
  margin-top: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding-bottom: 1.5rem;
}
.designer-credit-label {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--muted-foreground, #737373);
}
.designer-credit-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem;
  border-radius: 0.25rem;
  outline: none;
}
.designer-credit-logo-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  height: 14px;
}
.svg-f {
  height: 100%;
  width: auto;
  fill: #ff6700;
  transition: all 0.5s ease-out;
  transform: translateX(1rem);
  opacity: 0;
  max-width: 0;
  padding-right: 2px;
}
.svg-box {
  height: 100%;
  width: auto;
  fill: var(--muted-foreground, #525252);
  transition: all 0.5s ease-out;
  max-width: 15px;
  opacity: 1;
  overflow: hidden;
}
.svg-o {
  height: 100%;
  width: auto;
  fill: #ff6700;
  transition: all 0.5s ease-out;
  max-width: 0;
  opacity: 0;
  transform: scale(0.75);
  overflow: hidden;
}
.svg-ur {
  height: 100%;
  width: auto;
  fill: #ff6700;
  transition: all 0.5s ease-out;
  transform: translateX(-1rem);
  opacity: 0;
  max-width: 0;
  padding-left: 2px;
}

.designer-credit-link:hover .svg-f {
  transform: translateX(0);
  opacity: 1;
  max-width: 12px;
}
.designer-credit-link:hover .svg-box {
  opacity: 0;
  max-width: 0;
  transform: scale(0.75);
}
.designer-credit-link:hover .svg-o {
  opacity: 1;
  max-width: 12px;
  transform: scale(1);
}
.designer-credit-link:hover .svg-ur {
  transform: translateX(0);
  opacity: 1;
  max-width: 22px;
}
</style>
