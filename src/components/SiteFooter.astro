        <svg xmlns="http://www.w3.org/2000/svg" viewBox="171.852 0 93.17 63.521" class="svg-ur h-full w-auto fill-[#ff6700] transition-all duration-500 ease-out -translate-x-4 opacity-0 max-w-0 pl-[2px] group-hover/logo:translate-x-0 group-hover/logo:opacity-100 group-hover/logo:max-w-[22px]"><g><path d="M199.959,50.545c0,.666-.227,1.241-.681,1.724-.454.485-1.014.726-1.679.726h-12.977c-.666,0-1.225-.241-1.679-.726-.454-.483-.681-1.058-.681-1.724V0h-10.345v52.632c0,1.452.257,2.844.771,4.174.513,1.331,1.209,2.496,2.087,3.494.876.998,1.905,1.785,3.085,2.359,1.18.576,2.435.862,3.766.862h18.875c1.33,0,2.586-.286,3.766-.862,1.18-.574,2.223-1.361,3.13-2.359.908-.998,1.618-2.162,2.133-3.494.513-1.33.771-2.722.771-4.174V0h-10.345v50.545Z"></path><path d="M251.229,32.94l6.534-4.265c1.875-1.271,2.963-2.451,3.267-3.539.363-1.089.544-2.208.544-3.358v-11.797c0-1.27-.227-2.509-.68-3.72-.454-1.209-1.089-2.269-1.906-3.176s-1.785-1.648-2.904-2.223c-1.12-.574-2.345-.862-3.676-.862h-29.855v63.521h10.345v-19.873l9.347-5.535,11.252,25.408h11.524l-13.793-30.581ZM248.87,22.323l-15.971,9.074V10.345h15.971c.604,0,1.148.242,1.634.726.483.666.726,1.27.726,1.815v5.263c0,1.15-.181,1.997-.544,2.541-.242.606-.848,1.15-1.815,1.634Z"></path></g></svg>
