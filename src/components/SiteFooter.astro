---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <img src="/images/logo.png" alt="AK Concerts" width="28" height="28" style="border-radius:50%;" />
      <span class="footer-name font-display">AK <span class="text-gold">Concerts</span></span>
    </div>
    <p class="footer-copy">&copy; {year} AK Concerts · Alaska's live entertainment network</p>
    <div class="footer-links">
      <a href="#">Submit Event</a>
      <a href="#">Newsletter</a>
      <a href="#">About</a>
    </div>
  </div>

  <div class="designer-credit">
    <span>Designed By</span>
    <a href="https://fourak.com" target="_blank" rel="noopener noreferrer" title="FourAK" aria-label="Visit FourAK website (opens in a new window)">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 194.027 194.027">
        <g>
          <path d="M140.566,75.764c1.545,0,2.877.493,3.997,1.472,1.125.983,1.684,2.246,1.684,3.788v3.586s24.406,0,24.406,0v-10.109c0-3.083-.664-5.996-1.999-8.731-1.331-2.735-3.156-5.155-5.47-7.259-2.313-2.104-4.977-3.75-7.995-4.944-3.014-1.189-6.206-1.789-9.572-1.789h-37.002s0,23.986,0,23.986h31.952Z"></path>
          <path d="M53.462,118.264c-1.684,0-3.051-.491-4.103-1.473-1.052-.979-1.577-2.242-1.577-3.787v-3.588s-24.407,0-24.407,0v10.32c0,3.087.667,5.997,1.999,8.732,1.334,2.735,3.156,5.121,5.47,7.153,2.315,2.035,4.981,3.65,7.995,4.839,3.018,1.194,6.206,1.789,9.574,1.789h35.396s0-23.985,0-23.985h-30.346Z"></path>
          <path d="M47.781,81.024c0-1.542.526-2.805,1.577-3.788,1.053-.979,2.42-1.472,4.103-1.472h30.346s0-23.986,0-23.986h-35.396c-3.367,0-6.556.599-9.574,1.789-3.014,1.194-5.681,2.84-7.995,4.944s-4.136,4.524-5.47,7.259c-1.332,2.735-1.999,5.648-1.999,8.731v10.109s24.407,0,24.407,0v-3.586Z"></path>
          <path d="M146.247,113.004c0,1.545-.558,2.808-1.684,3.787-1.12.983-2.452,1.473-3.997,1.473h-31.952s0,23.985,0,23.985h37.002c3.366,0,6.558-.595,9.572-1.789,3.018-1.189,5.682-2.804,7.995-4.839,2.315-2.032,4.14-4.418,5.47-7.153,1.336-2.735,1.999-5.645,1.999-8.732v-10.32s-24.406,0-24.406,0v3.588Z"></path>
        </g>
      </svg>
    </a>
  </div>
</footer>

<style>
.site-footer{border-top:1px solid color-mix(in oklab,var(--border) 50%,transparent); padding-bottom: 2rem;}
.footer-inner{display:flex;flex-direction:column;gap:1.5rem;padding-block:2.5rem}
@media(min-width:640px){.footer-inner{flex-direction:row;align-items:center;justify-content:space-between}}
.footer-brand{display:flex;align-items:center;gap:.5rem}
.footer-badge{display:grid;place-items:center;width:1.75rem;height:1.75rem;border-radius:.375rem;font-size:.75rem;font-weight:700;color:var(--neon-foreground)}
.footer-name{font-weight:700}
.footer-copy{font-size:.75rem;color:var(--muted-foreground)}
.footer-links{display:flex;gap:1rem;font-size:.75rem;color:var(--muted-foreground)}
.footer-links a:hover{color:var(--foreground)}

.designer-credit {
  margin-top: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
}
.designer-credit span {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: var(--muted-foreground);
}
.designer-credit a {
  display: block;
  outline: none;
  border-radius: 4px;
}
.designer-credit svg {
  height: 2rem;
  width: auto;
  fill: var(--muted-foreground);
  transition: fill 0.3s;
}
.designer-credit a:hover svg {
  fill: #ff6700;
}
</style>
