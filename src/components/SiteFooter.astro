---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-top-row">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="AK Concerts" width="32" height="32" style="border-radius:50%;" />
        <span class="footer-name font-display">AK <span class="text-gold">Concerts</span></span>
      </div>

      <div class="footer-social-links">
        <a 
          href="https://www.facebook.com/akconcerts" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="AK Concerts on Facebook"
          title="Follow AK Concerts on Facebook"
          class="social-icon-btn social-fb"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <a 
          href="https://www.instagram.com/akconcert/" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="AK Concerts on Instagram"
          title="Follow AK Concerts on Instagram"
          class="social-icon-btn social-ig"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>

        <a 
          href="https://www.snapchat.com/add/akconcerts" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="AK Concerts on Snapchat"
          title="Add AK Concerts on Snapchat"
          class="social-icon-btn social-sc"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.046 2c-3.791 0-6.142 2.766-6.142 5.92 0 1.288.423 2.607 1.092 3.659.18.283.336.568.188.92-.128.307-.468.487-.783.568-.78.201-1.637.382-2.14.733-.312.217-.464.551-.433.916.037.433.324.776.71.979.914.481 2.274.654 3.32.748.243.022.428.217.433.461.026 1.045-.402 1.63-1.046 2.057-.286.19-.387.558-.233.864.152.302.484.472.824.417 1.222-.198 2.378-.89 3.868-.89 1.491 0 2.646.692 3.868.89.34.055.672-.115.824-.417.154-.306.053-.674-.233-.864-.644-.427-1.072-1.012-1.046-2.057.005-.244.19-.439.433-.461 1.046-.094 2.406-.267 3.32-.748.386-.203.673-.546.71-.979.031-.365-.121-.699-.433-.916-.503-.351-1.36-.532-2.14-.733-.315-.081-.655-.261-.783-.568-.148-.352.008-.637.188-.92.669-1.052 1.092-2.371 1.092-3.659 0-3.154-2.351-5.92-6.142-5.92z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-bottom-row">
      <p class="footer-copy">&copy; {year} AK Concerts &middot; Alaska's live entertainment network</p>

      <div class="footer-links">
        <a href="/map">Venue Map</a>
        <a href="/venues">Venues</a>
        <a href="/venue-pages">Venue Partners</a>
        <a href="/bands">Bands</a>
        <a href="/submit-band">Band Registration</a>
        <a href="/submit">Submit Event</a>
        <a href="/subscribe">Newsletter</a>
        <a href="/contact">Contact</a>
        <a href="/support">Support Us</a>
      </div>
    </div>
  </div>

  <div class="designer-credit-container mt-8 flex flex-col items-center justify-center gap-2 pb-6">
    <span class="designer-credit-label text-[9px] uppercase tracking-[2px] text-neutral-700">Designed By</span>
    <a href="https://fourak.com" target="_blank" rel="noopener noreferrer" class="designer-credit-link focus:outline-none focus-visible:ring-1 focus-visible:ring-white rounded group/logo flex items-center justify-center p-2" title="Four Media" aria-label="Visit Four Media website (opens in a new window)">
