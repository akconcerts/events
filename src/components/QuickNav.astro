---
import { Flame, Calendar, Music, Mic, Sparkles, Ticket, Snowflake, Compass } from 'lucide-astro';

const items = [
  { label: "Live Music", count: "34 shows", icon: "music", slug: "music" },
  { label: "Comedy", count: "8 shows", icon: "mic", slug: "comedy" },
  { label: "Festivals", count: "3 major", icon: "sparkles", slug: "festival" },
  { label: "Free Events", count: "15 free", icon: "ticket", slug: "free-events" },
  { label: "This Weekend", count: "22 shows", icon: "calendar", slug: "this-weekend" },
  { label: "Touring AK", count: "6 tours", icon: "flame", slug: "touring-ak" },
  { label: "Winter Series", count: "11 shows", icon: "snowflake", slug: "winter-series" },
  { label: "All Categories", count: "Browse all", icon: "compass", slug: "all" },
] as const;
---

<section id="discovery" class="quicknav container">
  <div class="quicknav-header">
    <div class="quicknav-title-wrap">
      <span class="quicknav-sub">Discover Events</span>
      <h2 class="quicknav-title font-display">Find Your Scene</h2>
    </div>
  </div>
  <div class="quicknav-grid">
    {items.map(({ label, count, icon, slug }) => {
      return (
        <a href={`/filters/${slug}`} class="qn-card">
          <div class="qn-inner">
            <span class="qn-label">{label}</span>
            <span class="qn-count">{count}</span>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
.quicknav {
  padding-block: 2rem 1.5rem;
}

.quicknav-header {
  margin-bottom: 1.25rem;
}

.quicknav-sub {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--brand-gold);
}

.quicknav-title {
  font-size: 1.85rem;
  font-weight: 800;
  margin: 0.2rem 0 0 0;
  letter-spacing: -0.02em;
}

.quicknav-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

@media(min-width:640px) {
  .quicknav-grid { grid-template-columns: repeat(4, 1fr); }
}

@media(min-width:1024px) {
  .quicknav-grid { grid-template-columns: repeat(8, 1fr); }
}

.qn-card {
  display: block;
  background: #0b1019;
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  padding: 0.85rem;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s ease;
}

.qn-card:hover {
  background: #111827;
  border-color: var(--brand-gold);
  transform: translateY(-2px);
}

.qn-inner {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.qn-label {
  font-size: 0.875rem;
  font-weight: 700;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.qn-count {
  font-size: 0.75rem;
  color: var(--brand-gold);
  font-weight: 600;
}
</style>
