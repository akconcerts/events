};
---

<section id="cities" class="quicknav container">
  <div class="quicknav-header">
    <h2 class="quicknav-title font-display">Jump in</h2>
    <span class="quicknav-sub">Quick filters</span>
  </div>
  <div class="quicknav-grid">
    {items.map(({ label, icon, tone }) => (
      <button class={`qn-card qn-${tone}`}>
        <div class={`qn-glow qn-glow-${tone}`}></div>
        <div class="qn-inner">
          <span class={`qn-icon qn-icon-${tone}`} set:html={icons[icon]} />
          <span class="qn-label">{label}</span>
        </div>
      </button>
    ))}
  </div>
</section>

<style>
.quicknav{padding-block:2.5rem 3.5rem}
@media(min-width:640px){.quicknav{padding-block:3.5rem}}
.quicknav-header{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:1.5rem}
.quicknav-title{font-size:1.5rem;font-weight:700}
@media(min-width:640px){.quicknav-title{font-size:1.875rem}}
.quicknav-sub{font-size:.75rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted-foreground)}
.quicknav-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.75rem}
@media(min-width:640px){.quicknav-grid{grid-template-columns:repeat(4,1fr)}}
@media(min-width:1024px){.quicknav-grid{grid-template-columns:repeat(8,1fr)}}
.qn-card{position:relative;overflow:hidden;border-radius:1rem;border:1px solid var(--border);background:var(--card);padding:1rem;text-align:left;transition:border-color .2s,background .2s}
.qn-card:hover{border-color:transparent;background:var(--secondary)}
.qn-glow{position:absolute;inset:0;z-index:0;opacity:0;transition:opacity .2s}
.qn-card:hover .qn-glow{opacity:1}
.qn-glow-neon{background:radial-gradient(80% 80% at 0% 0%,color-mix(in oklab,var(--neon) 30%,transparent),transparent)}
.qn-glow-cyan{background:radial-gradient(80% 80% at 100% 100%,color-mix(in oklab,var(--cyan) 30%,transparent),transparent)}
.qn-inner{position:relative;display:flex;flex-direction:column;gap:.75rem}
.qn-icon-neon{color:var(--neon)}
.qn-icon-cyan{color:var(--cyan)}
.qn-label{font-size:.875rem;font-weight:600}
</style>
