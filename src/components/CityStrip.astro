---
import { MapPin } from 'lucide-astro';

const cities = [
  { name: "Anchorage", count: 184 },
  { name: "Fairbanks", count: 72 },
  { name: "Juneau", count: 48 },
  { name: "Kenai Peninsula", count: 41 },
  { name: "Wasilla", count: 29 },
  { name: "Seward", count: 22 },
  { name: "Homer", count: 19 },
  { name: "Sitka", count: 14 },
];
---

<section class="city-section container">
  <div class="city-header">
    <div class="city-title-wrap">
      <span class="city-eyebrow"><MapPin size={14} /> Local Coverage</span>
      <h2 class="city-title font-display">Explore by Alaska City</h2>
    </div>
  </div>

  <div class="city-grid">
    {cities.map((c) => {
      const slug = c.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      return (
        <a href={`/cities/${slug}`} class="city-card">
          <div class="city-card-inner">
            <span class="city-card-name font-display">{c.name}</span>
            <div class="city-card-bottom">
              <span class="city-card-count">{c.count} upcoming</span>
              <span class="city-card-arrow">Browse →</span>
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
.city-section {
  padding-block: 2.5rem 1.5rem;
}

.city-header {
  margin-bottom: 1.5rem;
}

.city-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--brand-gold);
}

.city-title {
  font-size: 1.85rem;
  font-weight: 800;
  margin: 0.2rem 0 0 0;
  letter-spacing: -0.02em;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.85rem;
}

@media (min-width: 640px) {
  .city-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.city-card {
  display: block;
  background: #0b1019;
  border: 1px solid var(--border);
  border-radius: 0.875rem;
  padding: 1.125rem;
  text-decoration: none;
  color: inherit;
  transition: all 0.2s ease;
}

.city-card:hover {
  background: #111827;
  border-color: var(--brand-gold);
  transform: translateY(-2px);
}

.city-card-inner {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.city-card-name {
  font-size: 1.15rem;
  font-weight: 800;
  color: #ffffff;
}

.city-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid color-mix(in oklab, var(--border) 40%, transparent);
  padding-top: 0.5rem;
}

.city-card-count {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--muted-foreground);
}

.city-card-arrow {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--brand-gold);
}
</style>
