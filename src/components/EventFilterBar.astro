---
import { Calendar, MapPin, Building, Shapes } from 'lucide-astro';
import type { events as eventsType } from '../data/events';

interface Props {
  events: typeof eventsType;
  showTimelineFilter?: boolean;
}

const { events: propEvents, showTimelineFilter = true } = Astro.props;

const cities = [...new Set(propEvents.map(e => e.city))].sort();
const dates = [...new Set(propEvents.map(e => e.date))].sort();
const venues = [...new Set(propEvents.map(e => e.venue))].sort();
const categories = [...new Set(propEvents.map(e => e.category))].sort();
---

<div class="filter-controls-wrapper container">
  <div class="filter-bar">
    <div class="filter-group">
      <label for="filter-city">City</label>
      <select id="filter-city">
        <option value="all">All Cities</option>
        {cities.map(c => <option value={c}>{c}</option>)}
      </select>
    </div>
    
    <div class="filter-group">
      <label for="filter-date">Date</label>
      <select id="filter-date">
        <option value="all">All Dates</option>
        {dates.map(d => <option value={d}>{d}</option>)}
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-venue">Venue</label>
      <select id="filter-venue">
        <option value="all">All Venues</option>
        {venues.map(v => <option value={v}>{v}</option>)}
      </select>
    </div>

    <div class="filter-group">
      <label for="filter-category">Type</label>
      <select id="filter-category">
        <option value="all">All Types</option>
        {categories.map(c => <option value={c}>{c}</option>)}
      </select>
    </div>

    <!-- Conditional Timeline Selector (Upcoming/Past/All) -->
    {showTimelineFilter && (
      <div class="filter-group">
        <label for="filter-timeline">Timeline</label>
        <select id="filter-timeline">
          <option value="upcoming">Upcoming</option>
          <option value="past">Past History</option>
          <option value="all">All Events</option>
        </select>
      </div>
    )}

    <!-- Sort Order Selector -->
    <div class="filter-group">
      <label for="filter-sort">Sort Order</label>
      <select id="filter-sort">
        <option value="asc">Oldest First</option>
        <option value="desc">Newest First</option>
      </select>
    </div>
  </div>

  <div class="view-toggles">
    <button class="view-toggle active" data-view="date" aria-label="Sort by Date" title="Sort by Date"><Calendar size={20} /></button>
    <button class="view-toggle" data-view="city" aria-label="Group by City" title="Group by City"><MapPin size={20} /></button>
    <button class="view-toggle" data-view="venue" aria-label="Group by Venue" title="Group by Venue"><Building size={20} /></button>
    <button class="view-toggle" data-view="category" aria-label="Group by Category" title="Group by Category"><Shapes size={20} /></button>
  </div>
</div>

<script>
  // Helper to format date in local YYYY-MM-DD
  const getLocalDateString = () => {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  };

  const todayStr = getLocalDateString();

  function applyFilters() {
    const city = (document.getElementById('filter-city') as HTMLSelectElement).value;
    const date = (document.getElementById('filter-date') as HTMLSelectElement).value;
    const venue = (document.getElementById('filter-venue') as HTMLSelectElement).value;
    const category = (document.getElementById('filter-category') as HTMLSelectElement).value;
    
    const timelineEl = document.getElementById('filter-timeline') as HTMLSelectElement | null;
    const timeline = timelineEl ? timelineEl.value : 'all';

    const eventRows = document.querySelectorAll('.event-row');
    const groupBlocks = document.querySelectorAll('.group-block');

    eventRows.forEach((row) => {
      const el = row as HTMLElement;
      const matchCity = city === 'all' || el.dataset.city === city;
      const matchDate = date === 'all' || el.dataset.date === date;
      const matchVenue = venue === 'all' || el.dataset.venue === venue;
      const matchCategory = category === 'all' || el.dataset.category === category;

      // Timeline Filter
      const eventDate = el.dataset.date || '';
      let matchTimeline = true;
      if (timeline === 'upcoming') {
        matchTimeline = eventDate >= todayStr;
      } else if (timeline === 'past') {
        matchTimeline = eventDate < todayStr;
      }

      if (matchCity && matchDate && matchVenue && matchCategory && matchTimeline) {
        el.style.display = 'flex';
      } else {
        el.style.display = 'none';
      }
    });

    // Hide group blocks if they have no visible events
    groupBlocks.forEach((block) => {
      const el = block as HTMLElement;
      const visibleEvents = el.querySelectorAll('.event-row[style="display: flex;"], .event-row:not([style*="display: none"])');
      if (visibleEvents.length === 0) {
        el.style.display = 'none';
      } else {
        el.style.display = 'block';
      }
    });
  }

  function applySorting() {
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const sortOrder = sortSelect ? sortSelect.value : 'asc';
    const eventLists = document.querySelectorAll('.event-list');

    eventLists.forEach(list => {
      const rows = Array.from(list.querySelectorAll('.event-row')) as HTMLElement[];
      rows.sort((a, b) => {
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';
        const dateCompare = dateA.localeCompare(dateB);
        if (dateCompare !== 0) {
          return sortOrder === 'asc' ? dateCompare : -dateCompare;
        }

        // If dates are equal, sort by time (e.g. 7p-10p)
        const timeA = a.querySelector('.event-row-time')?.textContent?.trim() || '';
        const timeB = b.querySelector('.event-row-time')?.textContent?.trim() || '';
        return sortOrder === 'asc' ? timeA.localeCompare(timeB) : -timeA.localeCompare(timeB);
      });

      // Re-append sorted rows to container
      rows.forEach(row => list.appendChild(row));
    });
  }

  document.getElementById('filter-city')?.addEventListener('change', applyFilters);
  document.getElementById('filter-date')?.addEventListener('change', applyFilters);
  document.getElementById('filter-venue')?.addEventListener('change', applyFilters);
  document.getElementById('filter-category')?.addEventListener('change', applyFilters);
  
  document.getElementById('filter-timeline')?.addEventListener('change', () => {
    applyFilters();
    applySorting();
  });
  document.getElementById('filter-sort')?.addEventListener('change', applySorting);

  // View Mode Toggles
  const toggles = document.querySelectorAll('.view-toggle');
  toggles.forEach(btn => {
    btn.addEventListener('click', (e) => {
      toggles.forEach(t => t.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');
      const viewMode = target.dataset.view;
      
      document.querySelectorAll('.events-view-container').forEach(container => {
        (container as HTMLElement).style.display = 'none';
      });
      const activeContainer = document.getElementById(`view-${viewMode}`);
      if (activeContainer) {
        activeContainer.style.display = 'block';
      }
      // Re-apply filters and sorting to ensure visibility and ordering is correct
      applyFilters();
      applySorting();
    });
  });

  // On page load: initialize filter state
  const init = () => {
    const timelineSelect = document.getElementById('filter-timeline') as HTMLSelectElement | null;
    if (timelineSelect) {
      timelineSelect.value = 'upcoming';
    }
    applyFilters();
    applySorting();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
.filter-controls-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2rem;
}
@media (min-width: 1024px) {
  .filter-controls-wrapper {
    flex-direction: row;
    align-items: flex-end;
  }
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  padding-block: 1rem;
  background: var(--card);
  border-radius: .5rem;
  border: 1px solid var(--border);
  padding-inline: 1rem;
  flex: 1;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: .25rem;
  flex: 1;
  min-width: 140px;
}
.filter-group label {
  font-size: .75rem;
  text-transform: uppercase;
  color: var(--muted-foreground);
  font-weight: 600;
  letter-spacing: .05em;
}
.filter-group select {
  background: var(--background);
  border: 1px solid var(--border);
  color: var(--foreground);
  padding: .5rem;
  border-radius: .25rem;
  font-size: .875rem;
  outline: none;
}
.filter-group select:focus {
  border-color: var(--brand-gold);
}

.view-toggles {
  display: flex;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: .5rem;
  overflow: hidden;
  height: max-content;
}

.view-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: .75rem 1rem;
  color: var(--muted-foreground);
  background: transparent;
  transition: all .2s;
  border-right: 1px solid var(--border);
  cursor: pointer;
}
.view-toggle:last-child {
  border-right: none;
}
.view-toggle:hover {
  background: var(--secondary);
  color: var(--foreground);
}
.view-toggle.active {
  background: var(--brand-gold);
  color: var(--brand-navy);
}
</style>
