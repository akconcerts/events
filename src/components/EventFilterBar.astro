---
import { Calendar, MapPin, Building, Shapes, Search, X } from 'lucide-astro';
import type { events as eventsType } from '../data/events';
import { getAlaskaTodayDate } from '../utils/date';

interface Props {
  events: typeof eventsType;
  showTimelineFilter?: boolean;
}

const { events: propEvents, showTimelineFilter = true } = Astro.props;

const currentDate = getAlaskaTodayDate();

const cities = [...new Set(propEvents.map(e => e.city))].sort();
const dates = [...new Set(propEvents.map(e => e.date))]
  .filter(d => d >= currentDate)
  .sort();
const years = [...new Set(propEvents.map(e => e.date.slice(0, 4)))].sort().reverse();
const venues = [...new Set(propEvents.map(e => e.venue))].sort();
const categories = [...new Set(propEvents.map(e => e.category))].sort();
---

<div class="sticky-filter-wrapper">
  <div class="filter-controls-wrapper container">
    <!-- Top Search & Results Count Row -->
    <div class="search-bar-row">
      <div class="search-input-wrap">
        <Search class="search-icon" size={16} />
        <input 
          type="search" 
          id="filter-search" 
          placeholder="Search artists, events, venues, cities..." 
          autocomplete="off" 
        />
      </div>

      <div class="results-badge" id="results-count">
        Showing <span id="count-num">{propEvents.length}</span> events
      </div>
    </div>

    <!-- Filters & View Toggles Grid -->
    <div class="filter-bar">
      <div class="filter-group">
        <label for="filter-city">City</label>
        <select id="filter-city">
          <option value="all">All Cities</option>
          {cities.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-year">Year</label>
        <select id="filter-year">
          <option value="all">All Years</option>
          {years.map(y => <option value={y}>{y}</option>)}
        </select>
      </div>
      
      <div class="filter-group">
        <label for="filter-date">Date Range</label>
        <select id="filter-date">
          <option value="upcoming" selected>Upcoming Shows</option>
          <option value="tonight">Tonight</option>
          <option value="tomorrow">Tomorrow</option>
          <option value="weekend">This Weekend</option>
          <option value="next7">Next 7 Days</option>
          <option value="next30">Next 30 Days</option>
          <option value="all">All Dates</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-venue">Venue</label>
        <select id="filter-venue">
          <option value="all">All Venues</option>
          {venues.map(v => <option value={v}>{v}</option>)}
        </select>
      </div>

      <div class="filter-group">
        <label for="filter-category">Type</label>
        <select id="filter-category">
          <option value="all">All Types</option>
          {categories.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>

      {showTimelineFilter && (
        <div class="filter-group">
          <label for="filter-timeline">Timeline</label>
          <select id="filter-timeline">
            <option value="upcoming">Upcoming</option>
            <option value="past">Past History</option>
            <option value="all">All Events</option>
          </select>
        </div>
      )}

      <div class="filter-group">
        <label for="filter-sort">Sort Order</label>
        <select id="filter-sort">
          <option value="asc" selected>Chronological</option>
          <option value="desc">Newest First</option>
        </select>
      </div>

      <div class="filter-group view-toggles-group">
        <label>View Mode</label>
        <div class="segmented-view-toggles">
          <button class="view-toggle segmented-btn active" data-view="date" data-label="Date View" title="List View"><Calendar size={13} /> <span>List</span></button>
          <button class="view-toggle segmented-btn" data-view="city" data-label="City View" title="Group by City"><MapPin size={13} /> <span>City</span></button>
          <button class="view-toggle segmented-btn" data-view="venue" data-label="Venue View" title="Group by Venue"><Building size={13} /> <span>Venue</span></button>
          <button class="view-toggle segmented-btn" data-view="category" data-label="Type View" title="Group by Type"><Shapes size={13} /> <span>Type</span></button>
        </div>
      </div>
    </div>

    <!-- Active Chips Bar -->
    <div class="active-chips-bar" id="active-chips-bar" style="display: none;">
      <span class="chips-label">Active Filters:</span>
      <div class="chips-list" id="chips-list"></div>
      <button id="clear-all-chips" class="clear-chips-btn">Clear All</button>
    </div>
  </div>
</div>

<script>
  const getAlaskaTodayDate = () => {
    try {
      const formatter = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Anchorage',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      });
      return formatter.format(new Date());
    } catch (e) {
      const d = new Date();
      d.setHours(d.getHours() - 8);
      return d.toISOString().slice(0, 10);
    }
  };

  const getTimeMinutes = (timeStr: string = ''): number => {
    if (!timeStr || timeStr === 'TBA' || timeStr === '?') return 9999;
    const match = timeStr.match(/(\d{1,2})(?::(\d{2}))?\s*(a|p|am|pm)?/i);
    if (!match) return 9999;
    let hour = parseInt(match[1], 10);
    const min = match[2] ? parseInt(match[2], 10) : 0;
    const ampm = (match[3] || '').toLowerCase();
    if (ampm.startsWith('p') && hour < 12) hour += 12;
    if (ampm.startsWith('a') && hour === 12) hour = 0;
    return hour * 60 + min;
  };

  const getAlaskaDaysAheadStr = (days: number): string => {
    const d = new Date();
    d.setDate(d.getDate() + days);
    try {
      const formatter = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'America/Anchorage',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      });
      return formatter.format(d);
    } catch (e) {
      d.setHours(d.getHours() - 8);
      return d.toISOString().slice(0, 10);
    }
  };

  const todayStr = getAlaskaTodayDate();
  const tomorrowStr = getAlaskaDaysAheadStr(1);
  const sevenDaysAheadStr = getAlaskaDaysAheadStr(7);
  const thirtyDaysAheadStr = getAlaskaDaysAheadStr(30);

  const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
  const citySelect = document.getElementById('filter-city') as HTMLSelectElement | null;
  const yearSelect = document.getElementById('filter-year') as HTMLSelectElement | null;
  const dateSelect = document.getElementById('filter-date') as HTMLSelectElement | null;
  const venueSelect = document.getElementById('filter-venue') as HTMLSelectElement | null;
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
  const timelineSelect = document.getElementById('filter-timeline') as HTMLSelectElement | null;
  const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;

  const countNum = document.getElementById('count-num');
  const activeChipsBar = document.getElementById('active-chips-bar');
  const chipsList = document.getElementById('chips-list');
  const clearAllChipsBtn = document.getElementById('clear-all-chips');

  function updateActiveChips() {
    if (!chipsList || !activeChipsBar) return;
    chipsList.innerHTML = '';
    let hasActive = false;

    const query = searchInput?.value.trim() || '';
    if (query) {
      hasActive = true;
      addChip(`Search: "${query}"`, () => {
        if (searchInput) searchInput.value = '';
        applyFilters();
      });
    }

    if (citySelect && citySelect.value !== 'all') {
      hasActive = true;
      addChip(`City: ${citySelect.value}`, () => {
        citySelect.value = 'all';
        applyFilters();
      });
    }

    if (yearSelect && yearSelect.value !== 'all') {
      hasActive = true;
      addChip(`Year: ${yearSelect.value}`, () => {
        yearSelect.value = 'all';
        applyFilters();
      });
    }

    if (dateSelect && dateSelect.value !== 'upcoming' && dateSelect.value !== 'all') {
      hasActive = true;
      const labelText = dateSelect.options[dateSelect.selectedIndex]?.text || dateSelect.value;
      addChip(`Date: ${labelText}`, () => {
        dateSelect.value = 'upcoming';
        applyFilters();
      });
    }

    if (venueSelect && venueSelect.value !== 'all') {
      hasActive = true;
      addChip(`Venue: ${venueSelect.value}`, () => {
        venueSelect.value = 'all';
        applyFilters();
      });
    }

    if (categorySelect && categorySelect.value !== 'all') {
      hasActive = true;
      addChip(`Type: ${categorySelect.value}`, () => {
        categorySelect.value = 'all';
        applyFilters();
      });
    }

    activeChipsBar.style.display = hasActive ? 'flex' : 'none';
  }

  function addChip(text: string, onRemove: () => void) {
    if (!chipsList) return;
    const chip = document.createElement('span');
    chip.className = 'chip';
    chip.innerHTML = `${text} <span class="chip-remove">&times;</span>`;
    chip.querySelector('.chip-remove')?.addEventListener('click', onRemove);
    chipsList.appendChild(chip);
  }

  function applyFilters() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    const city = citySelect?.value || 'all';
    const year = yearSelect?.value || 'all';
    const dateFilter = dateSelect?.value || 'upcoming';
    const venue = venueSelect?.value || 'all';
    const category = categorySelect?.value || 'all';
    const timeline = timelineSelect ? timelineSelect.value : 'all';

    const eventRows = document.querySelectorAll('.event-row');
    const groupBlocks = document.querySelectorAll('.group-block');
    let visibleCount = 0;

    eventRows.forEach((row) => {
      const el = row as HTMLElement;
      const eventDate = el.dataset.date || '';

      const matchCity = city === 'all' || el.dataset.city === city;
      const matchYear = year === 'all' || (eventDate && eventDate.startsWith(year));
      const matchVenue = venue === 'all' || el.dataset.venue === venue;
      const matchCategory = category === 'all' || el.dataset.category === category;

      // Dynamic Date Filtering
      let matchDate = true;
      if (dateFilter === 'upcoming') {
        matchDate = eventDate >= todayStr;
      } else if (dateFilter === 'tonight') {
        matchDate = eventDate === todayStr;
      } else if (dateFilter === 'tomorrow') {
        matchDate = eventDate === tomorrowStr;
      } else if (dateFilter === 'weekend') {
        matchDate = eventDate >= todayStr && eventDate <= getAlaskaDaysAheadStr(3);
      } else if (dateFilter === 'next7') {
        matchDate = eventDate >= todayStr && eventDate <= sevenDaysAheadStr;
      } else if (dateFilter === 'next30') {
        matchDate = eventDate >= todayStr && eventDate <= thirtyDaysAheadStr;
      } else if (dateFilter === 'all') {
        matchDate = true;
      } else {
        matchDate = eventDate === dateFilter;
      }

      // Text Search
      let matchQuery = true;
      if (query) {
        const textContent = el.textContent?.toLowerCase() || '';
        matchQuery = textContent.includes(query);
      }

      // Timeline Filter
      let matchTimeline = true;
      if (timeline === 'upcoming') {
        matchTimeline = eventDate >= todayStr;
      } else if (timeline === 'past') {
        matchTimeline = eventDate < todayStr;
      }

      if (matchCity && matchYear && matchDate && matchVenue && matchCategory && matchTimeline && matchQuery) {
        el.style.display = 'flex';
        visibleCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (countNum) {
      countNum.textContent = visibleCount.toLocaleString();
    }

    // Hide group blocks if they have no visible events
    groupBlocks.forEach((block) => {
      const el = block as HTMLElement;
      const visibleEvents = el.querySelectorAll('.event-row[style*="display: flex"], .event-row:not([style*="display: none"])');
      if (visibleEvents.length === 0) {
        el.style.display = 'none';
      } else {
        el.style.display = 'block';
      }
    });

    updateActiveChips();
  }

  function applySorting() {
    const sortOrder = sortSelect ? sortSelect.value : 'asc';

    // Sort day blocks in Date View (#view-date)
    const viewDate = document.getElementById('view-date');
    if (viewDate) {
      const dayBlocks = Array.from(viewDate.querySelectorAll('.day-block')) as HTMLElement[];
      dayBlocks.sort((a, b) => {
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';
        const cmp = dateA.localeCompare(dateB);
        return sortOrder === 'asc' ? cmp : -cmp;
      });
      dayBlocks.forEach(block => viewDate.appendChild(block));
    }

    // Sort event rows inside each event list by date and time
    const eventLists = document.querySelectorAll('.event-list');
    eventLists.forEach(list => {
      const rows = Array.from(list.querySelectorAll('.event-row')) as HTMLElement[];
      rows.sort((a, b) => {
        const dateA = a.dataset.date || '';
        const dateB = b.dataset.date || '';
        const dateCompare = dateA.localeCompare(dateB);
        if (dateCompare !== 0) {
          return sortOrder === 'asc' ? dateCompare : -dateCompare;
        }

        const timeA = a.querySelector('.event-row-time')?.textContent?.trim() || '';
        const timeB = b.querySelector('.event-row-time')?.textContent?.trim() || '';
        const minA = getTimeMinutes(timeA);
        const minB = getTimeMinutes(timeB);
        return sortOrder === 'asc' ? (minA - minB) : (minB - minA);
      });

      rows.forEach(row => list.appendChild(row));
    });
  }

  searchInput?.addEventListener('input', applyFilters);
  citySelect?.addEventListener('change', applyFilters);
  yearSelect?.addEventListener('change', applyFilters);
  dateSelect?.addEventListener('change', applyFilters);
  venueSelect?.addEventListener('change', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);
  
  timelineSelect?.addEventListener('change', () => {
    applyFilters();
    applySorting();
  });
  sortSelect?.addEventListener('change', applySorting);

  clearAllChipsBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (citySelect) citySelect.value = 'all';
    if (yearSelect) yearSelect.value = 'all';
    if (dateSelect) dateSelect.value = 'all';
    if (venueSelect) venueSelect.value = 'all';
    if (categorySelect) categorySelect.value = 'all';
    applyFilters();
  });

  // View Mode Toggles
  const toggles = document.querySelectorAll('.view-toggle');
  toggles.forEach(btn => {
    btn.addEventListener('click', (e) => {
      toggles.forEach(t => t.classList.remove('active'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('active');
      const viewMode = target.dataset.view;

      document.querySelectorAll('.events-view-container').forEach(container => {
        (container as HTMLElement).style.display = 'none';
      });
      const activeContainer = document.getElementById(`view-${viewMode}`);
      if (activeContainer) {
        activeContainer.style.display = 'block';
      }
      applyFilters();
      applySorting();
    });
  });

  const init = () => {
    applyFilters();
    applySorting();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
.sticky-filter-wrapper {
  position: sticky;
  top: 0;
  z-index: 40;
  background: rgba(10, 15, 30, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid color-mix(in oklab, var(--border) 50%, transparent);
  padding-block: 0.85rem;
  margin-bottom: 1.5rem;
}

.filter-controls-wrapper {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.search-bar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

.search-input-wrap {
  position: relative;
  flex: 1;
  min-width: 260px;
  display: flex;
  align-items: center;
}

.search-input-wrap .search-icon {
  position: absolute;
  left: 0.85rem;
  color: var(--brand-gold);
  pointer-events: none;
}

.search-input-wrap input {
  width: 100%;
  background: var(--background);
  color: var(--foreground);
  border: 1px solid color-mix(in oklab, var(--brand-gold) 40%, var(--border));
  border-radius: 0.625rem;
  padding: 0.625rem 0.85rem 0.625rem 2.4rem;
  font-size: 0.875rem;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.search-input-wrap input:focus {
  border-color: var(--brand-gold);
  box-shadow: 0 0 0 2px rgba(204, 164, 59, 0.2);
}

.results-badge {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--muted-foreground);
  background: var(--card);
  border: 1px solid var(--border);
  padding: 0.4rem 0.75rem;
  border-radius: 0.5rem;
  white-space: nowrap;
}

.results-badge span {
  color: var(--brand-gold);
}

.filter-bar {
  display: flex;
  align-items: flex-end;
  gap: 0.625rem;
  flex-wrap: wrap;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  flex: 1;
  min-width: 110px;
}

.filter-group label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--muted-foreground);
}

.filter-group select {
  background: var(--background);
  color: var(--foreground);
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  padding: 0.45rem 0.625rem;
  font-size: 0.8125rem;
  outline: none;
  cursor: pointer;
  transition: border-color 0.15s;
  height: 2.25rem;
}

.filter-group select:focus {
  border-color: var(--brand-gold);
}

.view-toggles-group {
  flex: 0 0 auto;
  min-width: auto;
}

.segmented-view-toggles {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  padding: 0.15rem;
  height: 2.25rem;
}

.segmented-btn {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.3rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted-foreground);
  background: transparent;
  border: none;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: all 0.15s ease;
  height: 100%;
}

.segmented-btn:hover {
  color: var(--foreground);
  background: rgba(255, 255, 255, 0.05);
}

.segmented-btn.active {
  background: var(--brand-gold) !important;
  color: var(--brand-navy) !important;
  font-weight: 700;
}

.active-chips-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding-top: 0.25rem;
  flex-wrap: wrap;
}

.chips-label {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--muted-foreground);
}

.chips-list {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  flex-wrap: wrap;
}

:global(.chip) {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.75rem;
  font-weight: 600;
  background: rgba(204, 164, 59, 0.14);
  border: 1px solid rgba(204, 164, 59, 0.35);
  color: var(--brand-gold);
  padding: 0.2rem 0.5rem;
  border-radius: 0.375rem;
}

:global(.chip-remove) {
  cursor: pointer;
  font-size: 0.95rem;
  line-height: 1;
  opacity: 0.7;
  transition: opacity 0.15s;
}

:global(.chip-remove:hover) {
  opacity: 1;
}

.clear-chips-btn {
  font-size: 0.72rem;
  font-weight: 700;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.3);
  padding: 0.2rem 0.5rem;
  border-radius: 0.375rem;
  cursor: pointer;
  transition: background 0.15s;
}

.clear-chips-btn:hover {
  background: rgba(239, 68, 68, 0.2);
}

@media (max-width: 767px) {
  .segmented-btn span {
    display: none;
  }
  .filter-group {
    min-width: 45%;
  }
}
</style>
