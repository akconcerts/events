---
const nav = [
  { href: "/", label: "Playing Soon" },
  { href: "/bands", label: "Bands" },
  { href: "/venues", label: "Venues" },
  { href: "/subscribe", label: "Newsletter" },
  { href: "/support", label: "Support" },
];
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="logo-link">
      <img src="/images/logo.png" alt="AK Concerts seal" width="44" height="44" class="logo-seal" />
      <span class="logo-text font-display">AK <span class="text-gold">Concerts</span></span>
    </a>
    <nav class="desktop-nav">
      {nav.map((n) => (
        <a href={n.href} class="nav-link">{n.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <a href="/support" class="submit-btn bg-gradient-gold">Support AK Concerts</a>
      <button aria-label="Menu" class="icon-btn mobile-menu-toggle" id="mobile-menu-toggle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav">
    <div class="mobile-nav-inner">
      {nav.map((n) => (
        <a href={n.href} class="mobile-nav-link">{n.label}</a>
      ))}
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => nav?.classList.toggle('open'));
  nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => nav?.classList.remove('open')));
</script>

<style>
.site-header{position:sticky;top:0;z-index:50;border-bottom:1px solid color-mix(in oklab,var(--border) 50%,transparent);background:color-mix(in oklab,var(--background) 70%,transparent);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.header-inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.75rem}
.logo-link{display:flex;align-items:center;gap:.625rem}
.logo-seal{width:44px;height:44px;border-radius:50%}
.logo-text{font-size:1.25rem;font-weight:700;letter-spacing:-.025em}
.desktop-nav{display:none;align-items:center;gap:.25rem}
@media(min-width:768px){.desktop-nav{display:flex}}
.nav-link{border-radius:9999px;padding:.375rem .75rem;font-size:.875rem;color:var(--muted-foreground);transition:background .2s,color .2s}
.nav-link:hover{background:var(--secondary);color:var(--foreground)}
.header-actions{display:flex;align-items:center;gap:.5rem}
.icon-btn{display:grid;place-items:center;width:2.25rem;height:2.25rem;border-radius:9999px;border:1px solid var(--border);background:var(--card);color:var(--muted-foreground);transition:color .2s}
.icon-btn:hover{color:var(--foreground)}
.submit-btn{display:none;border-radius:9999px;padding:.5rem 1rem;font-size:.875rem;font-weight:600;color:var(--neon-foreground);box-shadow:0 8px 30px -10px var(--brand-gold);transition:opacity .2s}
.submit-btn:hover{opacity:.9}
@media(min-width:640px){.submit-btn{display:inline-flex}}
.mobile-menu-toggle{display:grid}
@media(min-width:768px){.mobile-menu-toggle{display:none}}
.mobile-nav{display:none;border-top:1px solid color-mix(in oklab,var(--border) 50%,transparent);background:color-mix(in oklab,var(--background) 90%,transparent);padding:.75rem 1rem}
.mobile-nav.open{display:block}
@media(min-width:768px){.mobile-nav{display:none !important}}
.mobile-nav-inner{display:flex;flex-direction:column;gap:.25rem}
.mobile-nav-link{border-radius:.375rem;padding:.5rem .75rem;font-size:.875rem;color:var(--muted-foreground);transition:background .2s,color .2s}
.mobile-nav-link:hover{background:var(--secondary);color:var(--foreground)}
</style>
