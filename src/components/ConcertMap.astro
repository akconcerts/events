---
import { MapPin, Navigation, Music } from 'lucide-astro';
import venuesData from '../../venues.json';
import eventsData from '../data/events.json';
---

<div class="concert-map-wrapper container">
  <div class="map-header">
    <div class="map-title-group">
      <span class="map-badge"><MapPin class="icon-sm" /> Interactive Spatial Map</span>
      <h2>Explore Alaska Concert Venues</h2>
      <p class="map-sub">Click any pin to view venue location, address, capacity, and live events.</p>
    </div>
    <div class="map-city-pills" id="map-city-filters">
      <button class="city-pill active" data-city="all">All Cities</button>
      <button class="city-pill" data-city="Anchorage">Anchorage</button>
      <button class="city-pill" data-city="Fairbanks">Fairbanks</button>
      <button class="city-pill" data-city="Juneau">Juneau</button>
      <button class="city-pill" data-city="Girdwood">Girdwood</button>
      <button class="city-pill" data-city="Palmer">Palmer</button>
      <button class="city-pill" data-city="Talkeetna">Talkeetna</button>
      <button class="city-pill" data-city="Homer">Homer</button>
      <button class="city-pill" data-city="Seward">Seward</button>
    </div>
  </div>

  <!-- Leaflet Map Container -->
  <div class="map-container-box">
    <div id="ak-leaflet-map"></div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script is:inline define:vars={{ venuesData, eventsData }}>
  document.addEventListener('DOMContentLoaded', () => {
    const mapElement = document.getElementById('ak-leaflet-map');
    if (!mapElement || typeof L === 'undefined') return;

    // Alaska Center View Coordinates
    const initialLat = 61.2181;
    const initialLng = -149.9003;
    const initialZoom = 6;

    const map = L.map('ak-leaflet-map', {
      center: [initialLat, initialLng],
      zoom: initialZoom,
      scrollWheelZoom: false
    });

    // Dark Mode Tile Layer
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    const markers = [];

    // Custom Glowing Custom Icon
    const customIcon = L.divIcon({
      className: 'custom-venue-pin',
      html: `<div class="pin-marker"><span class="pin-dot"></span></div>`,
      iconSize: [24, 24],
      iconAnchor: [12, 12]
    });

    venuesData.forEach(venue => {
      if (!venue.lat || !venue.lng) return;

      const marker = L.marker([venue.lat, venue.lng], { icon: customIcon }).addTo(map);

      // Match venue events
      const venueNameClean = (venue.name || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      const matchingEvents = (eventsData || []).filter(e => {
        if (!e.venue) return false;
        const eNameClean = e.venue.toLowerCase().replace(/[^a-z0-9]/g, '');
        return eNameClean.includes(venueNameClean) || venueNameClean.includes(eNameClean);
      }).slice(0, 5);

      const citySlug = (venue.city || 'anchorage').toLowerCase().replace(/\s+/g, '-');
      const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent((venue.address || venue.name) + ', ' + venue.city + ', AK')}`;

      const popupContent = `
        <div class="venue-popup-card">
          <div class="popup-tag">${venue.city}</div>
          <h3 class="popup-title">${venue.name}</h3>
          <p class="popup-address">📍 ${venue.address || venue.city}</p>
          ${venue.capacity ? `<p class="popup-cap">⚡ Capacity: <strong>${venue.capacity}</strong> guests</p>` : ''}
          
          <!-- 3 Action Buttons -->
          <div class="popup-btn-row">
            <button type="button" class="popup-btn btn-events-toggle" onclick="this.parentElement.nextElementSibling.classList.toggle('open')">
              📅 Shows (${matchingEvents.length})
            </button>
            ${venue.website ? `<a href="${venue.website}" target="_blank" rel="noopener" class="popup-btn btn-site">🌐 Site</a>` : ''}
            <a href="${googleMapsUrl}" target="_blank" rel="noopener" class="popup-btn btn-nav">📍 Map</a>
          </div>

          <!-- Expandable Mini Table Drawer -->
          <div class="popup-events-drawer">
            ${matchingEvents.length > 0 ? `
              <table class="mini-events-table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Event</th>
                    <th>Time</th>
                  </tr>
                </thead>
                <tbody>
                  ${matchingEvents.map(e => `
                    <tr>
                      <td class="mini-date">${e.date}</td>
                      <td class="mini-title">
                        <a href="${e.ticketUrl || '#'}" target="_blank" rel="noopener">${e.title}</a>
                      </td>
                      <td class="mini-time">${e.time || ''}</td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            ` : `
              <p class="no-mini-events">No upcoming listed events at this venue currently.</p>
            `}
          </div>

          <!-- Master Bottom Row Link -->
          <div class="popup-master-footer">
            <a href="/cities/${citySlug}" class="popup-city-link">
              🏙️ View All ${venue.city} Current Events &rarr;
            </a>
          </div>
        </div>
      `;

      marker.bindPopup(popupContent);
      marker.venueCity = venue.city;
      markers.push(marker);
    });

    // City Filter Pill Logic
    const filterButtons = document.querySelectorAll('#map-city-filters .city-pill');
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCity = btn.getAttribute('data-city');

        let bounds = L.latLngBounds();
        let hasVisible = false;

        markers.forEach(m => {
          if (selectedCity === 'all' || m.venueCity === selectedCity) {
            map.addLayer(m);
            bounds.extend(m.getLatLng());
            hasVisible = true;
          } else {
            map.removeLayer(m);
          }
        });

        if (hasVisible && selectedCity !== 'all') {
          map.fitBounds(bounds, { padding: [50, 50], maxZoom: 12 });
        } else if (selectedCity === 'all') {
          map.setView([initialLat, initialLng], initialZoom);
        }
      });
    });
  });
</script>

<style>
  .concert-map-wrapper {
    margin-top: 3rem;
    margin-bottom: 3rem;
  }
  .map-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .map-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }
  .map-title-group h2 {
    font-size: 1.8rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }
  .map-sub {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }
  .map-city-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .city-pill {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .city-pill:hover, .city-pill.active {
    background: #38bdf8;
    color: #0f172a;
    border-color: #38bdf8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.4);
  }
  .map-container-box {
    width: 100%;
    height: 420px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #334155;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.4);
  }
  #ak-leaflet-map {
    width: 100%;
    height: 100%;
    background: #0f172a;
  }

  /* Custom Pins & Popups */
  :global(.custom-venue-pin) {
    background: transparent;
    border: none;
  }
  :global(.pin-marker) {
    width: 20px;
    height: 20px;
    background: #38bdf8;
    border: 3px solid #0f172a;
    border-radius: 50%;
    box-shadow: 0 0 10px #38bdf8, 0 0 20px #38bdf8;
    animation: pulse-pin 2s infinite;
  }
  @keyframes pulse-pin {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.7); }
    70% { transform: scale(1.1); box-shadow: 0 0 0 10px rgba(56, 189, 248, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(56, 189, 248, 0); }
  }
  :global(.leaflet-popup-content-wrapper) {
    background: #1e293b !important;
    color: #f8fafc !important;
    border-radius: 12px !important;
    border: 1px solid #334155 !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5) !important;
  }
  :global(.leaflet-popup-tip) {
    background: #1e293b !important;
  }
  :global(.venue-popup-card) {
    padding: 0.35rem 0.2rem;
    min-width: 250px;
    max-width: 320px;
  }
  :global(.popup-tag) {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
    margin-bottom: 0.15rem;
  }
  :global(.popup-title) {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.35rem 0;
    color: #ffffff;
  }
  :global(.popup-address), :global(.popup-cap) {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0.2rem 0;
  }
  :global(.popup-btn-row) {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }
  :global(.popup-btn) {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.4rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: #e2e8f0;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  :global(.popup-btn:hover) {
    background: #38bdf8;
    color: #0f172a;
    border-color: #38bdf8;
  }
  :global(.btn-events-toggle) {
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
  }
  :global(.popup-events-drawer) {
    display: none;
    max-height: 180px;
    overflow-y: auto;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.375rem;
    padding: 0.35rem;
    margin-block: 0.5rem;
  }
  :global(.popup-events-drawer.open) {
    display: block;
  }
  :global(.mini-events-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.72rem;
  }
  :global(.mini-events-table th) {
    text-align: left;
    color: #38bdf8;
    font-weight: 700;
    padding: 0.2rem 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  :global(.mini-events-table td) {
    padding: 0.3rem 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    color: #cbd5e1;
  }
  :global(.mini-events-table td.mini-title a) {
    color: #f1f5f9;
    font-weight: 600;
    text-decoration: none;
  }
  :global(.mini-events-table td.mini-title a:hover) {
    color: #38bdf8;
    text-decoration: underline;
  }
  :global(.no-mini-events) {
    font-size: 0.75rem;
    color: #94a3b8;
    margin: 0.35rem;
    font-style: italic;
  }
  :global(.popup-master-footer) {
    margin-top: 0.625rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
  }
  :global(.popup-city-link) {
    font-size: 0.78rem;
    font-weight: 700;
    color: #cca43b;
    text-decoration: none;
    display: block;
    padding: 0.25rem;
    border-radius: 0.25rem;
    transition: background 0.15s;
  }
  :global(.popup-city-link:hover) {
    background: rgba(204, 164, 59, 0.12);
    text-decoration: underline;
  }
</style>
