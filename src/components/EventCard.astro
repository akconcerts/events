---
interface Props {
  id: string;
  slug: string;
  title: string;
  artist: string;
  venue: string;
  city: string;
  date: string;
  doors: string;
  genre: string;
  age: string;
  price: string;
  free?: boolean;
  ticketUrl: string;
  image: string;
  featured?: boolean;
  size?: 'md' | 'lg';
}

const { title, artist, venue, city, date, doors, genre, price, free, featured, image, size = 'md' } = Astro.props;

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
---

<a href="#" class={`event-card ${size === 'lg' ? 'event-card-lg' : ''}`}>
  <div class={`card-image ${size === 'lg' ? 'aspect-16-10' : 'aspect-4-3'}`}>
    <img src={image} alt={title} loading="lazy" width="1024" height="1024" class="card-img" />
    <div class="card-img-overlay"></div>
    <div class="card-badges">
      <span class="badge badge-genre">{genre}</span>
      {featured && <span class="badge badge-featured bg-gradient-neon">Featured</span>}
      {free && <span class="badge badge-free">Free</span>}
    </div>
    <div class="card-price">{price}</div>
  </div>
  <div class="card-body">
    <div>
      <h3 class="card-title font-display">{title}</h3>
      <p class="card-artist">{artist}</p>
    </div>
    <div class="card-meta">
      <span class="meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg> {fmtDate(date)} · {doors}</span>
      <span class="meta-item"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg> {venue}, {city}</span>
    </div>
  </div>
</a>

<style>
.event-card{display:flex;flex-direction:column;overflow:hidden;border-radius:1rem;border:1px solid var(--border);background:var(--card);transition:border-color .3s,box-shadow .3s}
.event-card:hover{border-color:color-mix(in oklab,var(--neon) 50%,transparent);box-shadow:0 20px 60px -25px var(--neon)}
.card-image{position:relative;overflow:hidden}
.aspect-4-3{aspect-ratio:4/3}
.aspect-16-10{aspect-ratio:16/10}
.card-img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.event-card:hover .card-img{transform:scale(1.05)}
.card-img-overlay{position:absolute;inset:0;background:linear-gradient(to top,var(--card),color-mix(in oklab,var(--card) 30%,transparent),transparent)}
.card-badges{position:absolute;left:.75rem;top:.75rem;display:flex;flex-wrap:wrap;gap:.5rem}
.badge{border-radius:9999px;padding:.25rem .625rem;font-size:11px;font-weight:500;text-transform:uppercase;letter-spacing:.1em;backdrop-filter:blur(8px)}
.badge-genre{border:1px solid rgba(255,255,255,.2);background:rgba(0,0,0,.4)}
.badge-featured{font-weight:700;color:var(--neon-foreground)}
.badge-free{font-weight:700;background:var(--cyan);color:var(--neon-foreground)}
.card-price{position:absolute;bottom:.75rem;right:.75rem;border-radius:.5rem;border:1px solid rgba(255,255,255,.15);background:rgba(0,0,0,.5);padding:.25rem .625rem;font-size:.75rem;font-weight:600;backdrop-filter:blur(8px)}
.card-body{display:flex;flex:1;flex-direction:column;gap:.75rem;padding:1rem}
.card-title{font-size:1.125rem;font-weight:700;line-height:1.2;letter-spacing:-.025em}
@media(min-width:640px){.card-title{font-size:1.25rem}}
.card-artist{margin-top:.125rem;font-size:.875rem;color:var(--muted-foreground)}
.card-meta{margin-top:auto;display:flex;flex-wrap:wrap;gap:.75rem;font-size:.75rem;color:var(--muted-foreground)}
.meta-item{display:inline-flex;align-items:center;gap:.375rem}
</style>
